# Functions lint enforces LF (eslint linebreak-style); keep these LF on Windows checkouts too.
my-firebase-project/my-firebase-functions/**/*.ts text eol=lf
my-firebase-project/my-firebase-functions/**/*.js text eol=lf
my-firebase-project/my-firebase-functions/**/*.cjs text eol=lf
my-firebase-project/my-firebase-functions/**/*.json text eol=lf
my-firebase-project/my-firebase-functions/.eslintrc.js text eol=lf
my-firebase-project/my-firebase-functions/.editorconfig text eol=lf
scripts/*.cjs text eol=lf

# Rules and indexes deploy byte-for-byte; keep them LF so Windows and macOS deploys match.
my-firebase-project/*.rules text eol=lf
my-firebase-project/*.json text eol=lf
