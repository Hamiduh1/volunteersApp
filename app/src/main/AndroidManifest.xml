<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.volunteersApp">


    <!-- ===================================================================================== -->
    <!-- PERMISSIONS: Grouped for clarity                                                      -->
    <!-- ===================================================================================== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Camera and Storage Permissions -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />
    <!-- Permissions for Agora SDK -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH" />


    <application
        android:name=".VolunteersApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VolunteersApp"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="31">

        <!-- ===================================================================================== -->
        <!-- META-DATA                                                                             -->
        <!-- ===================================================================================== -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- ===================================================================================== -->
        <!-- CORE & MAIN ACTIVITIES                                                                -->
        <!-- ===================================================================================== -->
        <activity
            android:name=".general.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- =============================================================== -->
            <!--           ANDROID APP LINKS INTENT FILTER (NEW)                 -->
            <!-- =============================================================== -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Your domain -->
                <data android:scheme="https" />
                <data android:host="lvcaapp.com" />
                <!-- The path pattern for your live streams -->
                <data android:pathPattern="/stream/.*" />


            </intent-filter>
            <!-- =============================================================== -->

        </activity>

        <activity
            android:name=".ui.main.MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.VolunteersApp" />

        <activity
            android:name=".organizer.OrganizerMainActivity"
            android:label="Organizer Dashboard"
            android:exported="false" />


        <!-- ===================================================================================== -->
        <!-- AUTHENTICATION ACTIVITIES                                                             -->
        <!-- ===================================================================================== -->
        <activity
            android:name=".general.SignUpActivity"
            android:exported="false" />
        <activity
            android:name=".general.ForgotPasswordActivity"
            android:exported="false" />


        <!-- ===================================================================================== -->
        <!-- SETTINGS-RELATED ACTIVITIES (These are launched from the SettingsFragment)            -->
        <!-- ===================================================================================== -->
        <activity android:name=".ui.profile.AccountSettingsActivity" android:label="Account" android:parentActivityName=".ui.main.MainActivity" android:exported="false"/>
        <activity android:name=".ui.profile.ProfileSupportActivity" android:label="Support" android:parentActivityName=".ui.main.MainActivity" android:exported="false"/>
        <activity android:name=".general.PrivacySecurityActivity" android:label="Privacy &amp; Security" android:parentActivityName=".ui.main.MainActivity" android:exported="false"/>
        <activity android:name=".ui.profile.HowToUseActivity" android:label="How to Use" android:parentActivityName=".ui.main.MainActivity" android:exported="false"/>
        <activity android:name=".ui.profile.TermsConditionsActivity" android:label="Terms and Conditions" android:parentActivityName=".ui.main.MainActivity" android:exported="false"/>


        <!-- ===================================================================================== -->
        <!-- JOB & EVENT ACTIVITIES                                                                -->
        <!-- ===================================================================================== -->

        <activity
            android:name=".jobs.JobPostDetailActivity"
            android:exported="false"
            android:label="Job Details"/>



        <activity
            android:name=".employer.ui.profile.ManageProfileActivity"
            android:exported="false"
            android:label="@string/manage_organization_profile_title" />


        <!-- ===================================================================================== -->
        <!-- OTHER FEATURE ACTIVITIES                                                              -->
        <!-- ===================================================================================== -->
        <activity
            android:name=".general.MapsActivity"
            android:label="Map"
            android:exported="false" />

        <activity
            android:name=".general.CalenderActivity"
            android:label="Select Date"
            android:exported="false" />


        <activity android:name=".wallet.TransactionActivity"
            android:exported="false" />

        <activity
            android:name=".wallet.PaymentsActivity"
            android:exported="false"
            android:screenOrientation="fullSensor" />

        <activity
            android:name=".wallet.TransactActivity"
            android:exported="false"
            android:label="Transfer" />


        <!-- ===================================================================================== -->
        <!-- PROVIDERS AND SERVICES                                                                -->
        <!-- ===================================================================================== -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>


        <activity
            android:name=".streams.StartStreamActivity"
            android:exported="false" />

        <activity
            android:name=".streams.LiveStreamActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|screenSize"/>

        <!-- Chat Activity Registration -->
        <activity
            android:name=".chat.ChatActivity"
            android:label="Chat"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
