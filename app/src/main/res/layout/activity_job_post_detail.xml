<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".JobPostDetailActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_job_detail"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- ProgressBar was also in the updated version -->
            <ProgressBar
                android:id="@+id/progressBarDetailLoading"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:visibility="visible"/>

            <!-- All your TextViews like textViewDetailJobTitle, etc. would go here -->
            <TextView
                android:id="@+id/textViewDetailJobTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.AppCompat.Headline"
                app:layout_constraintTop_toBottomOf="@id/progressBarDetailLoading"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Senior Developer Needed for Awesome Project" />
            <TextView
                android:id="@+id/textViewDetailOrgName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                app:layout_constraintTop_toBottomOf="@id/textViewDetailJobTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Innovative Tech Solutions Inc." />

            <TextView
                android:id="@+id/textViewDetailDateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/date"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                app:layout_constraintTop_toBottomOf="@id/textViewDetailOrgName"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/textViewDetailDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                app:layout_constraintTop_toTopOf="@id/textViewDetailDateLabel"
                app:layout_constraintBottom_toBottomOf="@id/textViewDetailDateLabel"
                app:layout_constraintStart_toEndOf="@id/textViewDetailDateLabel"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="2024-12-25" />

            <TextView
                android:id="@+id/textViewDetailLocationLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/location"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                app:layout_constraintTop_toBottomOf="@id/textViewDetailDate"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/textViewDetailLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                app:layout_constraintTop_toTopOf="@id/textViewDetailLocationLabel"
                app:layout_constraintBottom_toBottomOf="@id/textViewDetailLocationLabel"
                app:layout_constraintStart_toEndOf="@id/textViewDetailLocationLabel"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Remote / New York, NY" />

            <TextView
                android:id="@+id/textViewDetailDescriptionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/description"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/textViewDetailLocation"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/textViewDetailDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                app:layout_constraintTop_toBottomOf="@id/textViewDetailDescriptionLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="This is a detailed description of the job, outlining the responsibilities, requirements, and any other pertinent information that a volunteer might need to know before applying for this exciting opportunity." />

            <TextView
                android:id="@+id/textViewDetailSkillsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/skills_required"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/textViewDetailDescription"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/textViewDetailSkills"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                app:layout_constraintTop_toBottomOf="@id/textViewDetailSkillsLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Java, Android Development, Firebase, Problem Solving" />

            <TextView
                android:id="@+id/textViewDetailUrgencyLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/urgency"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/textViewDetailSkills"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/textViewDetailUrgency"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                app:layout_constraintTop_toBottomOf="@id/textViewDetailUrgencyLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="High" />

            <Button
                android:id="@+id/buttonViewOrgProfile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/view_organization_profile"
                app:layout_constraintTop_toBottomOf="@id/textViewDetailUrgency"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                style="?attr/materialButtonOutlinedStyle"/>

            <Button
                android:id="@+id/buttonApplyNow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/apply_now"
                app:layout_constraintTop_toBottomOf="@id/buttonViewOrgProfile"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginBottom="16dp"/>



            <!-- ... rest of your TextViews and Buttons ... -->
            <!-- Make sure their constraints are relative to each other -->
            <!-- and the parent ConstraintLayout or the ProgressBar -->

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>