<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="4dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/textViewJobTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadline6"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/textViewJobStatus"
            android:layout_marginEnd="8dp"
            tools:text="Community Clean-up Drive" />

        <TextView
            android:id="@+id/textViewJobStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/textViewJobTitle"
            app:layout_constraintBottom_toBottomOf="@id/textViewJobTitle"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="OPEN"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@drawable/status_background_open" /> <!-- We'll create this drawable -->

        <TextView
            android:id="@+id/textViewJobDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBody2"
            app:drawableStartCompat="@drawable/ic_date_range_24"
            android:drawablePadding="4dp"
            app:layout_constraintTop_toBottomOf="@id/textViewJobTitle"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="2024-12-25" />

        <TextView
            android:id="@+id/textViewJobTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBody2"
            app:drawableStartCompat="@drawable/ic_time_24"
            android:drawablePadding="4dp"
            app:layout_constraintTop_toTopOf="@id/textViewJobDate"
            app:layout_constraintStart_toEndOf="@id/textViewJobDate"
            android:layout_marginStart="16dp"
            tools:text="10:00 AM" />

        <TextView
            android:id="@+id/textViewJobLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBody2"
            app:drawableStartCompat="@drawable/ic_location_24"
            android:drawablePadding="4dp"
            app:layout_constraintTop_toBottomOf="@id/textViewJobDate"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Central Park, Main Street" />

        <!-- You can add more fields like category, volunteers needed etc. -->

        <LinearLayout
            android:id="@+id/layoutActions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/textViewJobLocation"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonViewApplicants"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/applicants"
                android:textSize="12sp"
                android:layout_marginEnd="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonEditJob"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/edit"
                android:textSize="12sp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonToggleStatusJob"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                tools:text="Close"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDeleteJob"
                style="?attr/materialButtonOutlinedStyle"
                app:icon="@drawable/ic_delete_24"
                app:iconTint="@android:color/holo_red_dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:tooltipText="@string/tooltip_delete_job"
                android:contentDescription="@string/cd_delete_job" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>