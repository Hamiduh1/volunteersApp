<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MyPostedJobsActivity">

    <!-- RecyclerView to display the list of posted jobs -->
    <!-- It's constrained to all four sides of the parent, so it fills the available space. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewMyPostedJobs"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        tools:listitem="@layout/item_my_job_posting"
        android:visibility="gone" /> <!-- Start as GONE, make VISIBLE when data is loaded -->

    <!-- TextView to display when there are no jobs posted -->
    <!-- Centered horizontally and vertically in the parent. -->
    <TextView
        android:id="@+id/textViewNoJobs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/you_haven_t_posted_any_opportunities_yet"
        android:textSize="16sp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"
        tools:visibility="visible"/> <!-- tools:visibility for design preview -->

    <!-- ProgressBar to indicate loading -->
    <!-- Centered horizontally and vertically in the parent. -->
    <ProgressBar
        android:id="@+id/progressBarMyJobs"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"
        tools:visibility="visible"/> <!-- tools:visibility for design preview -->

</androidx.constraintlayout.widget.ConstraintLayout>