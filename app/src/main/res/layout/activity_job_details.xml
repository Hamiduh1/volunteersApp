<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".JobDetailsActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarJobDetails"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Renamed scrollView to contentLayoutJobDetails AND made it initially gone -->
    <ScrollView
        android:id="@+id/contentLayoutJobDetails"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"
        app:layout_constraintBottom_toTopOf="@+id/buttonApplyNow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fillViewport="true"
        android:visibility="gone"
        tools:visibility="visible">  <!-- tools:visibility for design preview -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <ImageView
                android:id="@+id/imageViewJobDetailImage"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_business_black_24dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:contentDescription="@string/job_image_description" />

            <TextView
                android:id="@+id/textViewJobDetailTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Headline5"
                app:layout_constraintTop_toBottomOf="@id/imageViewJobDetailImage"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Community Cleanup Volunteer" />

            <TextView
                android:id="@+id/textViewJobDetailOrgName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                android:textColor="?attr/colorPrimary"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/textViewJobDetailTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Green Earth Society" />

            <TextView
                android:id="@+id/textViewJobDetailLocationLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textStyle="bold"
                android:text="@string/location_label"
                app:layout_constraintTop_toBottomOf="@id/textViewJobDetailOrgName"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/textViewJobDetailLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:layout_constraintTop_toTopOf="@id/textViewJobDetailLocationLabel"
                app:layout_constraintBottom_toBottomOf="@id/textViewJobDetailLocationLabel"
                app:layout_constraintStart_toEndOf="@id/textViewJobDetailLocationLabel"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="123 Community Park, Anytown" />

            <TextView
                android:id="@+id/textViewJobDetailDateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textStyle="bold"
                android:text="@string/date_label"
                app:layout_constraintTop_toBottomOf="@id/textViewJobDetailLocationLabel"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/textViewJobDetailDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:layout_constraintTop_toTopOf="@id/textViewJobDetailDateLabel"
                app:layout_constraintBottom_toBottomOf="@id/textViewJobDetailDateLabel"
                app:layout_constraintStart_toEndOf="@id/textViewJobDetailDateLabel"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="October 26, 2023" />

            <TextView
                android:id="@+id/textViewJobDetailTimeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textStyle="bold"
                android:text="@string/time_label"
                app:layout_constraintTop_toBottomOf="@id/textViewJobDetailDateLabel"
                app:layout_constraintStart_toStartOf="parent"
                android:visibility="gone"
                tools:visibility="visible"/>

            <TextView
                android:id="@+id/textViewJobDetailTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:layout_constraintTop_toTopOf="@id/textViewJobDetailTimeLabel"
                app:layout_constraintBottom_toBottomOf="@id/textViewJobDetailTimeLabel"
                app:layout_constraintStart_toEndOf="@id/textViewJobDetailTimeLabel"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="09:00 AM - 01:00 PM"
                android:visibility="gone"
                tools:visibility="visible"/>

            <TextView
                android:id="@+id/textViewVolunteersNeeded"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                app:layout_constraintTop_toBottomOf="@id/textViewJobDetailTimeLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Volunteers Needed: 10"
                android:visibility="gone"
                tools:visibility="visible"/>

            <TextView
                android:id="@+id/textViewJobDetailSkills"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                app:layout_constraintTop_toBottomOf="@id/textViewVolunteersNeeded"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Skills: Communication, Teamwork"
                android:visibility="gone"
                tools:visibility="visible"/>

            <TextView
                android:id="@+id/textViewJobDetailUrgency"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                app:layout_constraintTop_toBottomOf="@id/textViewJobDetailSkills"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Urgency: High"
                android:visibility="gone"
                tools:visibility="visible"/>

            <TextView
                android:id="@+id/textViewJobDetailHours"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                app:layout_constraintTop_toBottomOf="@id/textViewJobDetailUrgency"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Expected Hours: 4-5 hours"
                android:visibility="gone"
                tools:visibility="visible"/>

            <TextView
                android:id="@+id/textViewJobDetailContact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                app:layout_constraintTop_toBottomOf="@id/textViewJobDetailHours"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Contact: example@example.com"
                android:visibility="gone"
                tools:visibility="visible"/>

            <TextView
                android:id="@+id/textViewJobDetailRequirements"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                app:layout_constraintTop_toBottomOf="@id/textViewJobDetailContact"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Requirements: Must be 18+"
                android:visibility="gone"
                tools:visibility="visible"/>


            <TextView
                android:id="@+id/textViewJobDetailDescriptionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textStyle="bold"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle2"
                android:text="@string/description_label"
                app:layout_constraintTop_toBottomOf="@id/textViewJobDetailRequirements"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/textViewJobDetailDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="4dp"
                app:layout_constraintTop_toBottomOf="@id/textViewJobDetailDescriptionLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:text="Join us for a day of making our community cleaner and greener! We'll be picking up litter, planting flowers, and more. All ages welcome. Please bring gloves if you have them." />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <Button
        android:id="@+id/buttonApplyNow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/apply_now"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- This is the ProgressBar for the "Apply Now" button action -->
    <ProgressBar
        android:id="@+id/progressBarApply"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/buttonApplyNow"
        app:layout_constraintBottom_toBottomOf="@id/buttonApplyNow"
        app:layout_constraintStart_toStartOf="@id/buttonApplyNow"
        app:layout_constraintEnd_toEndOf="@id/buttonApplyNow"
        tools:visibility="visible" />


    <!-- ADDED: This is the ProgressBar for initial loading of details -->
    <ProgressBar
        android:id="@+id/progressBarLoadingDetails"
        style="?android:attr/progressBarStyleLarge"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:visibility="visible"
    app:layout_constraintTop_toBottomOf="@id/appBarLayout"
    app:layout_constraintBottom_toTopOf="@id/buttonApplyNow"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>