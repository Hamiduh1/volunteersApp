<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshLayoutSummary"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".organizer.OrganizerActivitySummaryFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/textViewSummaryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_activity_summary"
                android:textAppearance="?attr/textAppearanceHeadline5"
                android:layout_marginBottom="16dp" />
            <!-- Hosted Events Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/textViewHostedEventsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hosted_events_0"
                        android:textAppearance="?attr/textAppearanceSubtitle1"
                        android:layout_marginBottom="8dp"/>

                    <ProgressBar
                        android:id="@+id/progressBarHosted"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        android:visibility="gone"
                        tools:visibility="visible"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerViewHostedEventsSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="50dp"
                        android:contentDescription="@string/cd_hosted_events_list"
                    tools:listitem="@layout/item_hosted_event_summary"
                    tools:itemCount="0"/>

                    <TextView
                        android:id="@+id/textViewNoHostedEvents"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/no_hosted_events_found"
                        android:textAppearance="?attr/textAppearanceBody2"
                        android:gravity="center"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone"
                        tools:visibility="visible"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <!-- Events with Confirmed Volunteers Section -->
            <!-- Events with Confirmed Volunteers Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/textViewEventsWithVolunteersCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/events_with_confirmed_volunteers_0"
                        android:textAppearance="?attr/textAppearanceSubtitle1"
                        android:layout_marginBottom="8dp"/>

                    <ProgressBar
                        android:id="@+id/progressBarEventsWithVolunteers"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        android:visibility="gone"
                        tools:visibility="visible"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerViewEventsWithVolunteers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="50dp"
                        android:contentDescription="@string/cd_events_with_volunteers_list"
                    tools:listitem="@layout/item_event_with_volunteers_summary"
                    tools:itemCount="0"/>

                    <TextView
                        android:id="@+id/textViewNoEventsWithVolunteers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/no_events_with_volunteers_found"
                        android:textAppearance="?attr/textAppearanceBody2"
                        android:gravity="center"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone"
                        tools:visibility="visible"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <!-- Suggestions Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/textViewSuggestionsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/suggestions"
                    android:textAppearance="?attr/textAppearanceSubtitle1"
                    android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/textViewSuggestions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:lineSpacingMultiplier="1.2"
                        tools:text="- Create a new 'Tech Workshop' event.\n- Send reminders for 'Community Cleanup'."/>

                    <!-- Text View for No Suggestions -->
                    <TextView
                        android:id="@+id/textViewNoSuggestions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/no_suggestions_available"
                        android:textAppearance="?attr/textAppearanceBody2"
                        android:gravity="center"
                        android:paddingTop="8dp"
                        android:visibility="gone"
                        tools:visibility="visible"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
