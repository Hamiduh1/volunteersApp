<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".Waitlisted"> <!-- Changed context to .Waitlisted -->

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
    android:elevation="4dp"
    android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
    app:popupTheme="@style/ThemeOverlay.AppCompat.Light" /> <!-- Changed to ThemeOverlay -->

    <View
        android:layout_width="match_parent"
        android:layout_height="16dp" /> <!-- Adjusted space for consistency, avoid hardcoding "30sp" for layout spacing -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:weightSum="2">

    <Button
        android:id="@+id/button_approved"
        style="?android:attr/buttonBarButtonStyle"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/round_button"
    android:text="@string/approved"
    android:layout_marginEnd="4dp"/> <!-- Added margin between buttons -->
    <!-- android:clickable="true" is default for Button -->

    <Button
        android:id="@+id/button_waitlisted"
        style="?android:attr/buttonBarButtonStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/round_button1"
        android:text="@string/waitlisted"
        android:layout_marginStart="4dp"/> <!-- Added margin between buttons -->

</LinearLayout>

<View
android:layout_width="match_parent"
android:layout_height="16dp" />
    <!-- android:background="@android:color/holo_red_dark" Removed background from space, likely for debugging -->

    <!-- ListView Container -->
<FrameLayout
android:layout_width="match_parent"
android:layout_height="0dp"
android:layout_weight="1"> <!-- Allow ListView to take remaining space -->

<ListView
    android:id="@+id/listView_UnApproved"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:divider="@android:color/darker_gray"
android:dividerHeight="1dp"
android:padding="8dp"/>

<!-- Optional: TextView for empty list message -->
<TextView
    android:id="@+id/textView_emptyWaitlist"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:text="@string/no_events_on_your_waitlist"
    android:textAppearance="?android:attr/textAppearanceMedium"
    android:visibility="gone" /> <!-- Initially hidden -->

</FrameLayout>

    </LinearLayout>