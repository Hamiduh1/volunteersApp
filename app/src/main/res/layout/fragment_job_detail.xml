<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".jobs.JobDetailFragment">

    <!-- Scrollable Content Area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewJobDetail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="80dp"> <!-- Padding to ensure content isn't hidden by the button -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar_job_detail"
                android:layout_width="0dp"
                android:layout_height="?attr/actionBarSize"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:navigationIcon="@drawable/ic_arrow_back" />

            <ImageView
                android:id="@+id/imageViewEmployerLogoDetail"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_default_work_outline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/toolbar_job_detail"
                android:contentDescription="@string/cd_employer_logo" />

            <TextView
                android:id="@+id/textViewJobTitleDetail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:textAppearance="?attr/textAppearanceHeadline5"
                app:layout_constraintStart_toEndOf="@id/imageViewEmployerLogoDetail"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/imageViewEmployerLogoDetail"
                tools:text="Senior Software Engineer"/>

            <TextView
                android:id="@+id/textViewEmployerNameDetail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceSubtitle1"
                app:layout_constraintStart_toStartOf="@id/textViewJobTitleDetail"
                app:layout_constraintEnd_toEndOf="@id/textViewJobTitleDetail"
                app:layout_constraintTop_toBottomOf="@id/textViewJobTitleDetail"
                tools:text="Innovatech Solutions Ltd."/>

            <TextView
                android:id="@+id/textViewJobLocationDetail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:textAppearance="?attr/textAppearanceBody2"
                app:drawableStartCompat="@drawable/ic_location_on_18"
                app:layout_constraintStart_toStartOf="@id/textViewEmployerNameDetail"
                app:layout_constraintEnd_toEndOf="@id/textViewEmployerNameDetail"
                app:layout_constraintTop_toBottomOf="@id/textViewEmployerNameDetail"
                tools:text="New York, NY (Remote available)" />

            <TextView
                android:id="@+id/textViewJobTypeDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/background_category_tag"
                android:textColor="?attr/colorOnSecondary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imageViewEmployerLogoDetail"
                tools:text="Full-time"/>

            <TextView
                android:id="@+id/textViewJobCategoryDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/background_category_tag"
                android:textColor="?attr/colorOnSecondary"
                app:layout_constraintStart_toEndOf="@id/textViewJobTypeDetail"
                app:layout_constraintTop_toTopOf="@id/textViewJobTypeDetail"
                app:layout_constraintBottom_toBottomOf="@id/textViewJobTypeDetail"
                tools:text="Technology"/>

            <com.google.android.material.divider.MaterialDivider
                android:id="@+id/divider1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@id/textViewJobTypeDetail"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/label_job_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:text="@string/label_job_description"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/divider1"/>

            <TextView
                android:id="@+id/textViewJobDescriptionDetail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:textAppearance="?attr/textAppearanceBody1"
                android:lineSpacingExtra="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/label_job_description"
                tools:text="We are seeking a highly skilled Senior Software Engineer to join our dynamic team. The ideal candidate will have extensive experience in developing scalable applications and a passion for technology..."/>

            <TextView
                android:id="@+id/label_job_responsibilities"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:text="@string/label_job_responsibilities"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textViewJobDescriptionDetail"/>

            <LinearLayout
                android:id="@+id/linearLayoutResponsibilities"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/label_job_responsibilities"/>

            <TextView
                android:id="@+id/label_required_skills"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:text="@string/label_required_skills"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/linearLayoutResponsibilities"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupRequiredSkills"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/label_required_skills"/>

            <!-- FIXED: This TextView was missing -->
            <TextView
                android:id="@+id/textViewPostedDateDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:textAppearance="?attr/textAppearanceCaption"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/chipGroupRequiredSkills"
                tools:text="Posted on: January 15, 2023"/>

            <!-- FIXED: This TextView was also missing and is now restored -->
            <TextView
                android:id="@+id/textViewApplicationDeadlineDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginStart="16dp"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textColor="?attr/colorError"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textViewPostedDateDetail"
                tools:text="Apply by: February 28, 2023"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Centered Loading and Error Indicators -->
    <FrameLayout
        android:id="@+id/frame_layout_status"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true">

        <ProgressBar
            android:id="@+id/progressBarJobDetail"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            tools:visibility="visible"/>

        <TextView
            android:id="@+id/textViewErrorJobDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/error_loading_job_details"
            android:visibility="gone"
            tools:visibility="visible"/>
    </FrameLayout>

    <!-- Floating "Apply" Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonApplyNowDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:padding="12dp"
        android:text="@string/apply_now"
        app:icon="@drawable/ic_send_apply" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
