<?xml version="1.0" encoding="utf-8"?>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        tools:context=".events.EventDetailFragment">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar_layout_event_detail"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:fitsSystemWindows="true"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsing_toolbar_event_detail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:contentScrim="?attr/colorPrimary"
                app:expandedTitleMarginEnd="64dp"
                app:expandedTitleMarginStart="48dp"
                app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
                android:fitsSystemWindows="true">

                <ImageView
                    android:id="@+id/imageViewEventDetailHeader"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:srcCompat="@drawable/ic_image_placeholder"
                    android:contentDescription="@string/cd_event_header_image"
                    android:fitsSystemWindows="true" />

                <View
                    android:id="@+id/scrim_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/scrim_gradient_top_to_bottom" />
                <!-- Optional: Add a scrim for better text readability over the image -->

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar_event_detail"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    app:layout_collapseMode="pin"
                    app:popupTheme="@style/ThemeOverlay.AppCompat.Light"/>

            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollViewEventDetail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            android:clipToPadding="false"
            android:paddingBottom="16dp"> <!-- Reduced bottom padding if button is inside -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="24dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/textViewEventDetailName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceHeadline5"
                    tools:text="Community Cleanup Drive"
                    android:layout_marginBottom="16dp"/>

                <!-- Date and Time Section -->
                <LinearLayout
                    android:id="@+id/layout_date_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:id="@+id/icon_calendar"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_calendar_month"
                        app:tint="?attr/colorControlNormal"
                        android:contentDescription="@string/cd_calendar_icon"
                        android:layout_marginEnd="16dp"/>
                    <TextView
                        android:id="@+id/textViewEventDetailDateTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Sat, Oct 26, 2024 at 09:00 AM"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"/>
                </LinearLayout>

                <!-- Location Section -->
                <LinearLayout
                    android:id="@+id/layout_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:id="@+id/icon_location"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_location_on"
                        app:tint="?attr/colorControlNormal"
                        android:contentDescription="@string/cd_location_icon"
                        android:layout_marginEnd="16dp"/>
                    <TextView
                        android:id="@+id/textViewEventDetailLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Location: 123 Main Street, Anytown, USA"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"/>
                </LinearLayout>

                <!-- Description Header (Optional) -->
                <TextView
                    android:id="@+id/header_description_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/header_description"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle2"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/textViewEventDetailDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    tools:text="Join us for a community cleanup drive to make our neighborhood cleaner and greener. We will be focusing on picking up litter and beautifying the local park."
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                    android:lineSpacingMultiplier="1.2"/>

                <com.google.android.material.divider.MaterialDivider
                    android:id="@+id/divider_after_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"/>

                <!-- Organizer Info -->
                <LinearLayout
                    android:id="@+id/layout_organizer_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <ImageView
                        android:id="@+id/icon_organizer"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_person_outline"
                        app:tint="?attr/colorControlNormal"
                        android:contentDescription="@string/cd_organizer_icon"
                        android:layout_marginEnd="8dp"/>
                    <TextView
                        android:id="@+id/textViewEventDetailOrganizer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Hosted by: John Doe"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"/>
                </LinearLayout>

                <!-- Category/Type -->
                <LinearLayout
                    android:id="@+id/layout_category"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <ImageView
                        android:id="@+id/icon_category"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_category"
                        app:tint="?attr/colorControlNormal"
                        android:contentDescription="@string/cd_category_icon"
                        android:layout_marginEnd="8dp"/>
                    <TextView
                        android:id="@+id/textViewEventDetailCategory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Type: Community Service"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"/>
                </LinearLayout>

                <!-- Skills Required -->
                <LinearLayout
                    android:id="@+id/layoutSkillsRequired"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"
                    tools:visibility="visible">
                    <ImageView
                        android:id="@+id/icon_skills"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_build"
                        app:tint="?attr/colorControlNormal"
                        android:contentDescription="@string/cd_skills_icon"
                        android:layout_marginEnd="8dp"/>
                    <TextView
                        android:id="@+id/textViewEventDetailSkills"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Skills Required: Gardening, Teamwork"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"/>
                </LinearLayout>

                <!-- Volunteer Slots/Limit -->
                <LinearLayout
                    android:id="@+id/layoutVolunteerSlots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"
                    tools:visibility="visible">
                    <ImageView
                        android:id="@+id/icon_slots"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_groups"
                        app:tint="?attr/colorControlNormal"
                        android:contentDescription="@string/cd_slots_icon"
                        android:layout_marginEnd="8dp"/>
                    <TextView
                        android:id="@+id/textViewEventDetailSlots"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Slots: 20 / 50"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"/>
                </LinearLayout>

                <!-- Registered Volunteers Count -->
                <LinearLayout
                    android:id="@+id/layoutVolunteersApplied"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"
                    tools:visibility="visible">
                    <ImageView
                        android:id="@+id/icon_registered_volunteers"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_how_to_reg"
                        app:tint="?attr/colorControlNormal"
                        android:contentDescription="@string/cd_registered_volunteers_icon"
                        android:layout_marginEnd="8dp"/>
                    <TextView
                        android:id="@+id/textViewVolunteersAppliedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Registered: 15"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"/>
                </LinearLayout>

                <!-- Required Volunteers -->
                <LinearLayout
                    android:id="@+id/layoutRequiredVolunteers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"
                    tools:visibility="visible">
                    <ImageView
                        android:id="@+id/icon_required_volunteers"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_people_alt"
                        app:tint="?attr/colorControlNormal"
                        android:contentDescription="@string/cd_required_volunteers_icon"
                        android:layout_marginEnd="8dp"/>
                    <TextView
                        android:id="@+id/textViewEventDetailRequiredVolunteers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Needs: 30 volunteers"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"/>
                </LinearLayout>

                <!-- Payment Information -->
                <LinearLayout
                    android:id="@+id/layoutPayment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"
                    tools:visibility="visible">
                    <ImageView
                        android:id="@+id/icon_payment"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_payment"
                        app:tint="?attr/colorControlNormal"
                        android:contentDescription="@string/cd_payment_icon"
                        android:layout_marginEnd="8dp"/>
                    <TextView
                        android:id="@+id/textViewEventDetailPayment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Payment: $10.00"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"/>
                </LinearLayout>

                <!-- Event Status -->
                <LinearLayout
                    android:id="@+id/layoutEventStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="24dp"
                    android:visibility="gone"
                    tools:visibility="visible">
                    <ImageView
                        android:id="@+id/icon_status"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_event_available"
                        app:tint="?attr/colorControlNormal"
                        android:contentDescription="@string/cd_status_icon"
                        android:layout_marginEnd="8dp"/>
                    <TextView
                        android:id="@+id/textViewEventDetailStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Status: Upcoming"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                        android:textStyle="italic"/>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonEventDetailAction"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="@string/apply_for_event_button"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"/>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Error TextView: Centered, shown when content fails to load -->
        <TextView
            android:id="@+id/textViewErrorEventDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/error_loading_event_details"
            android:textAppearance="?attr/textAppearanceBody1"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            tools:visibility="visible"
            android:padding="16dp"/>

        <ProgressBar
            android:id="@+id/progressBarEventDetail"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            tools:visibility="visible"/>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>


