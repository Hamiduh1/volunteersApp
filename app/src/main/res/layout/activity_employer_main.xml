<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/employer_drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".EmployerMainActivity"
    tools:openDrawer="start">

    <!-- Main content area -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/employer_app_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/employer_toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/colorPrimary"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- FragmentContainerView to host employer navigation graph
android:id="@+id/nav_host_test"

        -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/nav_host_fragment_content_employer_main"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:defaultNavHost="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            app:navGraph="@navigation/employer_navigation" />
        <!--
            Note on android:layout_marginBottom:
            If your FragmentContainerView's content is meant to be displayed *above*
            the BottomNavigationView and not be overlapped by it, you might need
            to adjust its bottom constraint or margin.
            A common way within CoordinatorLayout is to ensure the BottomNavigationView
            is an sibling and the FragmentContainerView has app:layout_behavior.
            The `android:layout_marginBottom="?attr/actionBarSize"` you had before
            is typically used if the bottom navigation *height* is similar to the action bar,
            but it's better to use constraints or ensure proper behavior with CoordinatorLayout
            so it adapts if the BottomNav height changes.
            For now, I've removed it as the layout_behavior should handle scrolling, but
            if content is obscured, revisit this.
        -->

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/employer_bottom_nav_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="?android:attr/windowBackground"
            app:menu="@menu/employer_bottom_nav_menu" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Navigation drawer for Employer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/employer_nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header_employer_main"
        app:menu="@menu/employer_drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>


