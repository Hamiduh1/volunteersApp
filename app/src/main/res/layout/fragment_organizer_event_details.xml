<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".organizer.OrganizerEventDetailsFragment">

    <!-- TODO: Add UI elements for event details here -->
    <!-- For example: -->
    <TextView
        android:id="@+id/textView_event_title_details"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:textAppearance="@style/TextAppearance.AppCompat.Headline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Event Title" />

    <TextView
        android:id="@+id/textView_event_description_details"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        app:layout_constraintEnd_toEndOf="@+id/textView_event_title_details"
        app:layout_constraintStart_toStartOf="@+id/textView_event_title_details"
        app:layout_constraintTop_toBottomOf="@+id/textView_event_title_details"
        tools:text="This is a detailed description of the event, explaining what it is about, what volunteers will do, and any other relevant information." />

    <!-- Add more views like ImageView for event image, TextViews for date, time, location, etc. -->

</androidx.constraintlayout.widget.ConstraintLayout>
