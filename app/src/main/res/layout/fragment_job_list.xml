<?xml version="1.0" encoding="utf-8"?>
    <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.myjobs.JobListFragment">
        <!-- Or your shared JobListFragment path -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_jobs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/text_view_no_jobs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_jobs_found"
            android:layout_gravity="center"
            android:visibility="gone"
            tools:visibility="visible"
            android:textAppearance="?attr/textAppearanceListItem"/>

        <ProgressBar
            android:id="@+id/progress_bar_job_list"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            tools:visibility="visible"/>

    </FrameLayout>
