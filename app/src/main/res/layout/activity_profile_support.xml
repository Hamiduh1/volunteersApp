<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    tools:context=".ProfileSupportActivity">

<androidx.appcompat.widget.Toolbar
android:id="@+id/toolbar_profile_support"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    android:background="?attr/colorPrimary"
    android:elevation="4dp"
    android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
    app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

<TextView
android:id="@+id/textViewSupportTitle"
android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/support"
    android:textSize="28sp"
    android:textColor="?attr/colorOnSurface"
    android:layout_gravity="center_horizontal"
    android:layout_marginTop="24dp"
    android:layout_marginBottom="16dp"
    android:textStyle="bold"/>
    <!-- Optional: Make title bold -->

    <!-- FrameLayout to allow ProgressBar to overlay or be in the same space as RecyclerView -->
<FrameLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"> <!-- Changed to wrap_content or a fixed height depending on design -->
<!-- If RecyclerView height is fixed (e.g., 150dp), FrameLayout can match -->

<androidx.recyclerview.widget.RecyclerView
    android:id="@+id/accountlistview1"
    android:layout_width="match_parent"
    android:layout_height="150dp"
android:clipToPadding="false"
android:paddingStart="8dp"
android:paddingEnd="8dp"
tools:listitem="@layout/item_support"
tools:itemCount="3"
tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
android:orientation="horizontal" /> <!-- Explicitly setting orientation for tools preview -->
<!-- Note: LinearLayoutManager in Java code will set the actual orientation at runtime -->


<ProgressBar
    android:id="@+id/progressBarSupport"
    style="?android:attr/progressBarStyle"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:visibility="gone"
tools:visibility="visible"/> <!-- Visible in tools preview -->
</FrameLayout>

    <!-- You could add more content below the RecyclerView if needed -->
    <!-- For example, a TextView for error messages if the list fails to load and is empty -->
<TextView
android:id="@+id/textViewSupportError"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginTop="16dp"
android:gravity="center"
android:text="@string/support_items_not_available"
    android:textColor="?attr/colorError"
    android:visibility="gone"
    tools:visibility="gone"/>

    </LinearLayout>
