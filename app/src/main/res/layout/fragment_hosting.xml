<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".host.Hosting">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_host_new_event"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/host_a_new_event"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:icon="@drawable/ic_add_circle_outline" />
    <!-- You'll need to add an icon like ic_add_circle_outline to your drawables -->
    <!-- and define @string/host_a_new_event in strings.xml -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_hosted_events"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/button_host_new_event"
        android:padding="8dp"
        tools:listitem="@layout/item_hosted_event" />
    <!-- tools:listitem is for design-time preview.
         Create item_hosted_event.xml for your RecyclerView items. -->

    <ProgressBar
        android:id="@+id/progressBar_hosting"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone"
        tools:visibility="visible"/> <!-- tools:visibility for design-time preview -->

    <TextView
        android:id="@+id/textView_no_hosted_events"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:gravity="center"
        android:text="@string/loading_hosted_events"
        android:textSize="18sp"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="You haven't hosted any events yet."/> <!-- tools:text for design-time preview -->

</RelativeLayout>