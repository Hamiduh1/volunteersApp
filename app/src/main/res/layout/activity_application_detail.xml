<?xml version="1.0" encoding="utf-8"?>
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context=".ApplicationDetailActivity">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_application_detail"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:titleTextColor="@android:color/white"
            android:elevation="4dp"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ProgressBar
                android:id="@+id/progressBarApplicationDetail"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:visibility="gone"
                tools:visibility="visible"/>

            <ScrollView
                android:id="@+id/contentContainerApplicationDetail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Volunteer Profile Image (Optional) -->
                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/imageViewVolunteerProfileDetail"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="16dp"
                        android:src="@drawable/ic_profile_placeholder"
                        app:civ_border_width="2dp"
                        app:civ_border_color="#FF000000"/>

                    <TextView
                        android:id="@+id/textViewVolunteerNameDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        tools:text="Volunteer Name"
                        android:textAppearance="@style/TextAppearance.AppCompat.Large"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/textViewApplicationDateDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        tools:text="Applied on: Jan 1, 2024"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status"
                        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/textViewApplicationStatusDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Pending"
                        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/volunteer_email"
                        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/textViewVolunteerEmailDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="volunteer@example.com"
                        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                        android:layout_marginBottom="12dp"
                        android:autoLink="email"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/volunteer_phone"
                        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/textViewVolunteerPhoneDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="123-456-7890"
                        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                        android:layout_marginBottom="12dp"
                        android:autoLink="phone"/>

                    <!-- Example: Cover Letter -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cover_letter_message"
                        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"/>
                    <TextView
                        android:id="@+id/textViewCoverLetterDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="This is a sample cover letter from the volunteer, expressing their interest in the event and their qualifications."
                        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                        android:layout_marginBottom="16dp"/>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        android:gravity="center">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonAcceptApplication"
                            style="@style/Widget.MaterialComponents.Button"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="@string/accept"
                            android:backgroundTint="@android:color/holo_green_dark"
                            android:visibility="gone"
                            tools:visibility="visible"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonRejectApplication"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/reject"
                            app:strokeColor="@android:color/holo_red_dark"
                            android:textColor="@android:color/holo_red_dark"
                            android:visibility="gone"
                            tools:visibility="visible"/>
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>
        </RelativeLayout>
    </LinearLayout>