<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground"> <!-- For touch feedback -->

    <ImageView
        android:id="@+id/imageViewSupportIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="16dp"
        tools:srcCompat="@drawable/ic_default_placeholder" /> <!-- Placeholder for design -->

    <TextView
        android:id="@+id/textViewSupportText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="16sp"
        android:textColor="?android:attr/textColorPrimary"
        tools:text="Support Item Title" />

    <!-- Optional: You could add a chevron or arrow icon here if items are clickable to go somewhere else -->
    <!-- <ImageView
        android:id="@+id/imageViewSupportAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_chevron_right"
        android:tint="?attr/colorControlNormal" /> -->

</LinearLayout>