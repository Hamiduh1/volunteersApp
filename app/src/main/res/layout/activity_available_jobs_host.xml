<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".jobs.AvailableJobsActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_available_jobs_host"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <FrameLayout
        android:id="@+id/fragment_container_available_jobs"
        android:layout_width="match_parent"
    android:layout_height="match_parent" />

    <!--
    Removed RecyclerView, TextView (textViewNoJobs), and ProgressBar (progressBarLoading)
    as these are now managed by the AvailableJobsFragment and its layout (fragment_available_jobs.xml)
    -->

</LinearLayout>

