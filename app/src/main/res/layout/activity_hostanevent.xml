<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HostAnEvent"
    android:fitsSystemWindows="true"
    android:descendantFocusability="beforeDescendants">

    <LinearLayout
        android:id="@+id/activityMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp"
        android:focusableInTouchMode="true">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            android:elevation="4dp"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            android:layout_marginStart="-16dp"
            android:layout_marginEnd="-16dp" />

        <android.widget.Space
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <!-- Date of the Event -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/date_of_the_event"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:layout_marginBottom="4dp"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/HostAnEventDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="@string/dd_mm_yyyy"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"/>
            <Button
                android:id="@+id/GoToCalender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                style="?attr/materialButtonOutlinedStyle"
                android:text="@string/select_date" />
        </RelativeLayout>

        <!-- Event Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="?attr/textInputFilledStyle"
            android:layout_marginBottom="16dp"
            android:hint="@string/event_name_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/HostAnEventName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLines="1"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Organizer Name (was Host Name) -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="?attr/textInputFilledStyle"
            android:layout_marginBottom="16dp"
            android:hint="@string/organizer_name_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/HostAnEventHostName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords"
                android:maxLines="1"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Event Location -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="?attr/textInputFilledStyle"
            android:layout_marginBottom="16dp"
            android:hint="@string/event_location_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/HostAnEventLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLines="1"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Type of the Event -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/type_of_the_event"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:layout_marginBottom="4dp"/>
        <Spinner
            android:id="@+id/types"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            style="@style/Widget.AppCompat.Spinner.Underlined"
            android:layout_marginBottom="16dp"/>

        <!-- Payment -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="?attr/textInputFilledStyle"
            android:layout_marginBottom="16dp"
            android:hint="@string/payment_amount_optional_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/HostAnEventMoney"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:maxLines="1"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Description -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="?attr/textInputFilledStyle"
            android:layout_marginBottom="16dp"
            android:hint="@string/description_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/HostAnEventDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="96dp"
                android:inputType="textMultiLine|textCapSentences"
                android:gravity="top"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Image URL -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="?attr/textInputFilledStyle"
            android:layout_marginBottom="16dp"
            android:hint="@string/image_url_optional_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/HostAnEventImageUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:maxLines="1"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Skills Required -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="?attr/textInputFilledStyle"
            android:layout_marginBottom="16dp"
            android:hint="@string/skills_required_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/HostAnEventSkillsRequired"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLines="1"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Required Volunteers -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="?attr/textInputFilledStyle"
            android:layout_marginBottom="16dp"
            android:hint="@string/required_volunteers_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/HostAnEventRequiredVolunteers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLines="1"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Volunteer Limit -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="?attr/textInputFilledStyle"
            android:layout_marginBottom="16dp"
            android:hint="@string/volunteer_limit_hint_0_for_no_limit">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/HostAnEventVolunteerLimit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLines="1"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Time -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/time_label"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:layout_marginBottom="4dp"/>
        <TimePicker
            android:id="@+id/HostAnEventTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:timePickerMode="spinner"
            android:layout_marginBottom="24dp"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"> <!-- Reduced bottom margin for ScrollView padding -->
            <Button
                android:id="@+id/CancelHost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_marginEnd="8dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/cancel"
                style="?attr/materialButtonOutlinedStyle" />

            <Button
                android:id="@+id/NextStep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="8dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                style="?attr/materialButtonStyle"
                android:text="@string/create_event_button" />
        </RelativeLayout>

    </LinearLayout>
</ScrollView>
