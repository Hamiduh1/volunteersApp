<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".employer.ui.applications.EmployerApplicationDetailFragment">

    <ProgressBar
        android:id="@+id/progressBarApplicationDetail"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone"
        tools:visibility="visible"/>

    <ScrollView
        android:id="@+id/contentContainerApplicationDetail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Volunteer Profile Image -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/imageViewVolunteerProfileDetail"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:src="@drawable/ic_profile_placeholder"
                app:civ_border_width="2dp"
                app:civ_border_color="#FFDDDDDD"
                android:contentDescription="@string/cd_volunteer_profile_image" />

            <!-- Volunteer Name -->
            <TextView
                android:id="@+id/textViewVolunteerNameDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                tools:text="Volunteer Applicant Name"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
                android:layout_marginBottom="4dp"/>

            <!-- Application Date -->
            <TextView
                android:id="@+id/textViewApplicationDateDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                tools:text="Applied on: Sep 24, 2025 - 10:00 AM"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                android:layout_marginBottom="16dp"/>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"/>

            <!-- Job Title Section - ADDED/MODIFIED -->
            <TextView
                android:id="@+id/textViewJobTitleLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_job_title"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>
            <TextView
                android:id="@+id/textViewJobTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Senior Software Developer"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
            android:layout_marginBottom="16dp"/>

            <!-- Application Status Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_application_status"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>
            <TextView
                android:id="@+id/textViewApplicationStatusDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Pending"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginBottom="16dp"/>

            <!-- Volunteer Email Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_volunteer_email"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>
            <TextView
                android:id="@+id/textViewVolunteerEmailDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="volunteer@example.com"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
                android:layout_marginBottom="16dp"
                android:autoLink="email"/>

            <!-- Volunteer Phone Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_volunteer_phone"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>
            <TextView
                android:id="@+id/textViewVolunteerPhoneDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="123-456-7890"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
                android:layout_marginBottom="16dp"
                android:autoLink="phone"/>

            <!-- Notes from Volunteer / Cover Letter Section -->
            <TextView
                android:id="@+id/textViewLabelCoverLetter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_notes_from_volunteer"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"/>
            <TextView
                android:id="@+id/textViewCoverLetterDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="This is a sample message from the volunteer, expressing their interest in the job."
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
            android:layout_marginBottom="16dp"/>

            <!-- TODO: Add Buttons for Resume/Cover Letter Links if applicable -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonViewCoverLetter"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/button_view_cover_letter"
            app:icon="@drawable/ic_file_document"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            tools:visibility="visible"
            android:contentDescription="@string/cd_view_cover_letter_button" />

<com.google.android.material.button.MaterialButton
                android:id="@+id/buttonViewResume"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/button_view_resume"
                android:visibility="gone"
                tools:visibility="visible"
                app:icon="@drawable/ic_resume_file" />


            <!-- Action Buttons -->
            <LinearLayout
                android:id="@+id/layoutActionButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonAcceptApplication"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/button_accept_application"
                    app:icon="@drawable/ic_check_circle_default"
                    android:backgroundTint="@color/colorStatusAccepted"
                    android:contentDescription="@string/cd_accept_application_button" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonRejectApplication"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/button_reject_application"
                    app:icon="@drawable/ic_cancel_default"
                    app:strokeColor="@color/colorStatusRejected"
                    android:textColor="@color/colorStatusRejected"
                    android:contentDescription="@string/cd_reject_application_button"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</RelativeLayout>
