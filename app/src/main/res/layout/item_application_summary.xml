<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="4dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/imageViewItemVolunteerProfile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_profile_placeholder"
            app:civ_border_width="1dp"
            app:civ_border_color="#FFDDDDDD"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/textViewItemVolunteerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
            tools:text="Volunteer Applicant Name"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/imageViewItemVolunteerProfile"
            app:layout_constraintTop_toTopOf="@id/imageViewItemVolunteerProfile"
            app:layout_constraintEnd_toStartOf="@+id/textViewItemApplicationStatus"
            app:layout_constraintHorizontal_bias="0.0"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/textViewItemApplicationDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
            tools:text="Applied: Jan 10, 2024"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/imageViewItemVolunteerProfile"
            app:layout_constraintTop_toBottomOf="@id/textViewItemVolunteerName"
            app:layout_constraintBottom_toBottomOf="@id/imageViewItemVolunteerProfile"
            app:layout_constraintEnd_toStartOf="@+id/textViewItemApplicationStatus"/>

        <TextView
            android:id="@+id/textViewItemApplicationStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/status_background_pending"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        tools:text="Pending"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>

