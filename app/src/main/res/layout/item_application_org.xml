<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="4dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Volunteer Profile Image (Optional) -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/imageViewVolunteerProfileOrg"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_default_profile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Volunteer Name -->
        <TextView
            android:id="@+id/textViewVolunteerNameOrg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/textViewApplicationStatusOrg"
            app:layout_constraintStart_toEndOf="@+id/imageViewVolunteerProfileOrg"
            app:layout_constraintTop_toTopOf="@+id/imageViewVolunteerProfileOrg"
            app:layout_constraintBottom_toBottomOf="@+id/imageViewVolunteerProfileOrg"
        tools:text="Volunteer Name Here" />

        <!-- Application Status -->
        <TextView
            android:id="@+id/textViewApplicationStatusOrg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/status_background_pending"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/textViewVolunteerNameOrg"
            app:layout_constraintBottom_toBottomOf="@+id/textViewVolunteerNameOrg"
            tools:text="PENDING"
            tools:backgroundTint="@color/status_pending_color" />

        <!-- Event Title -->
        <TextView
            android:id="@+id/textViewEventTitleOrg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
            android:textColor="?android:attr/textColorSecondary"
            app:layout_constraintStart_toStartOf="@+id/textViewVolunteerNameOrg"
            app:layout_constraintTop_toBottomOf="@+id/textViewVolunteerNameOrg"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Event Title Applied For" />

        <!-- Applied Date -->
        <TextView
            android:id="@+id/textViewAppliedDateOrg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
            android:textColor="?android:attr/textColorTertiary"
            app:layout_constraintStart_toStartOf="@+id/textViewEventTitleOrg"
            app:layout_constraintTop_toBottomOf="@+id/textViewEventTitleOrg"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Applied on: YYYY-MM-DD" />

        <!-- Buttons for Actions (Optional - could be on a details screen instead) -->
        <LinearLayout
            android:id="@+id/layoutActionButtonsOrg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/textViewAppliedDateOrg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:visibility="gone">
            <!-- Set to visible if you want direct actions here -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonApproveOrg"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/approve"
                android:layout_marginEnd="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRejectOrg"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reject"
                app:strokeColor="@android:color/holo_red_dark"
                android:textColor="@android:color/holo_red_dark"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
