<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/organizer_drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:openDrawer="start"
    tools:context=".organizer.OrganizerMainActivity">

    <!-- Main content area -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Toolbar -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:theme="@style/Theme.VolunteersApp.AppBarOverlay">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/colorPrimary"
                app:popupTheme="@style/Theme.VolunteersApp.PopupOverlay" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- NavHostFragment Container -->
        <!-- This is where your NavController will manage fragments from organizer_nav_graph.xml -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/organizer_fragment_container"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            app:defaultNavHost="true"
            app:navGraph="@navigation/organizer_nav_graph"
            android:layout_marginBottom="?attr/actionBarSize"/>
        <!-- marginBottom is to make space for BottomNavigationView if it's outside the NavHost's area -->
        <!-- If BottomNav should be part of each screen controlled by NavHost,
             the NavHost might extend to the bottom and fragments handle their own bottom padding.
             For this structure where BottomNav is a sibling in CoordinatorLayout, marginBottom is okay. -->


        <!-- Bottom Navigation View -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/organizer_bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="?android:attr/windowBackground"
            app:menu="@menu/organizer_bottom_nav_menu" /> <!-- Ensure this menu file exists -->

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Navigation Drawer View -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/organizer_nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/organizer_nav_header"
        app:menu="@menu/organizer_drawer_menu" /> <!-- Ensure these files exist -->

</androidx.drawerlayout.widget.DrawerLayout>
