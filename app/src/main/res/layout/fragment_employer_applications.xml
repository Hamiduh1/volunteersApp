<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".employer.ui.applications.EmployerApplicationsFragment">

    <!-- Changed ID and tools:text to reflect Job Title -->
    <TextView
        android:id="@+id/textViewJobTitleForApplications"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
        android:padding="16dp"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Applications for 'Senior Software Engineer'" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewApplications"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/textViewJobTitleForApplications"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    tools:listitem="@layout/item_application_summary" />
    <!-- Ensure item_application_summary.xml is suitable for displaying JobApplication items -->

    <!-- Updated text and constraints for "No Applications" TextView -->
    <TextView
        android:id="@+id/textViewNoApplications"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_applications_found_for_this_job"
    android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
    android:visibility="gone"
    app:layout_constraintTop_toBottomOf="@id/textViewJobTitleForApplications"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    tools:visibility="visible"/>

    <!-- Updated constraints for ProgressBar -->
    <ProgressBar
        android:id="@+id/progressBarApplications"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/textViewJobTitleForApplications"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    tools:visibility="visible"/>

</androidx.constraintlayout.widget.ConstraintLayout>


