<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/organizer_nav_graph"
    app:startDestination="@id/startStreamActivity">

    <!--
    The <fragment> destinations that were previously here have been removed
    because their functionality is now handled by Jetpack Compose screens
    within the NavHost in 'OrganizerMainScreen.kt'.
    -->

    <!-- =============================================================== -->
    <!-- EXTERNAL ACTIVITY DEFINITIONS                                   -->
    <!-- =============================================================== -->

    <!-- Live Streaming Flow -->
    <activity
        android:id="@+id/startStreamActivity"
        android:name="com.example.volunteersApp.streams.StartStreamActivity"
        android:label="@string/title_start_stream" />

    <!-- THE FIX: Added the definition for LiveStreamActivity for the organizer -->
    <activity
        android:id="@+id/liveStreamActivity_organizer_side"
        android:name="com.example.volunteersApp.streams.LiveStreamActivity"
        android:label="@string/title_live_stream">
        <argument
            android:name="CHANNEL_NAME"
            app:argType="string" />
        <argument
            android:name="IS_HOST"
            app:argType="boolean"
            android:defaultValue="true" />
    </activity>

    <!-- Other Activities -->
    <activity
        android:id="@+id/mapsActivity_organizer_side"
        android:name="com.example.volunteersApp.general.MapsActivity"
        android:label="@string/title_map">
        <argument android:name="eventId" app:argType="string" app:nullable="true"/>
    </activity>

</navigation>
