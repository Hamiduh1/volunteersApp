<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/organizer_nav_graph"
    app:startDestination="@id/nav_organizer_home">

    <!-- Organizer's Main Dashboard -->
    <fragment
        android:id="@+id/nav_organizer_home"
        android:name="com.example.volunteersApp.organizer.OrganizerDashboardFragment"
        android:label="@string/title_organizer_dashboard"
        tools:layout="@layout/fragment_organizer_dashboard">

        <action
            android:id="@+id/action_organizerDashboardFragment_to_nav_host_event_organizer_side"
            app:destination="@id/nav_host_event_organizer_side" />
        <action
            android:id="@+id/action_organizerDashboardFragment_to_hostedEventsFragment"
            app:destination="@id/nav_hosted_events" />
        <action
            android:id="@+id/action_organizerDashboardFragment_to_organizerApplicationsFragment"
            app:destination="@id/nav_organizer_applications">
            <argument
                android:name="eventId"
                app:argType="string"
                app:nullable="true"
                android:defaultValue="@null" />
            <argument
                android:name="organizerId"
                app:argType="string"
                app:nullable="true"
                android:defaultValue="@null" />
        </action>
    </fragment>

    <!-- Fragment for Listing/Managing Hosted Events -->
    <fragment
        android:id="@+id/nav_hosted_events"
        android:name="com.example.volunteersApp.organizer.HostedEventsFragment"
        android:label="@string/title_my_hosted_events"
        tools:layout="@layout/fragment_hosted_events">

        <action
            android:id="@+id/action_hostedEventsFragment_to_eventDetailFragment"
            app:destination="@id/eventDetailFragment">
            <argument
                android:name="eventId"
                app:argType="string" />
        </action>
        <action
            android:id="@+id/action_hostedEventsFragment_to_nav_host_event"
            app:destination="@id/nav_host_event_organizer_side">
            <argument
                android:name="eventId"
                app:argType="string"
                app:nullable="true" />
        </action>
        <action
            android:id="@+id/action_hostedEventsFragment_to_viewApplicantsFragment"
            app:destination="@id/nav_organizer_applications">
            <argument
                android:name="eventId"
                app:argType="string" />
            <argument
                android:name="organizerId"
                app:argType="string"
                app:nullable="true"/>
        </action>
    </fragment>

    <!-- Generic Event Detail -->
    <fragment
        android:id="@+id/eventDetailFragment"
        android:name="com.example.volunteersApp.ui.eventdetails.EventDetailFragment"
        android:label="@string/title_event_details"
        tools:layout="@layout/fragment_event_detail">
        <argument
            android:name="eventId"
            app:argType="string" />
    </fragment>

    <!-- FRAGMENT for Creating/Editing an Event -->
    <fragment
        android:id="@+id/nav_host_event_organizer_side"
        android:name="com.example.volunteersApp.ui.hostevent.HostEventFragment"
        android:label="@string/title_host_or_edit_event"
        tools:layout="@layout/fragment_host_event">
        <argument
            android:name="eventId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <action
            android:id="@+id/action_nav_host_event_organizer_side_to_mapsActivity_organizer_side"
            app:destination="@id/mapsActivity_organizer_side" />
        <action
            android:id="@+id/action_nav_host_event_organizer_side_to_host_final_organizer_side"
            app:destination="@id/host_final_organizer_side" />
    </fragment>

    <activity
        android:id="@+id/mapsActivity_organizer_side"
        android:name="com.example.volunteersApp.MapsActivity"
        android:label="@string/title_map"
        tools:layout="@layout/activity_maps">
        <argument
            android:name="eventId"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="organizerId"
            app:argType="string"
            app:nullable="true" />
    </activity>

    <fragment
        android:id="@+id/host_final_organizer_side"
        android:name="com.example.volunteersApp.ui.hostevent.HostFinalFragment"
        android:label="@string/title_event_creation_complete"
        tools:layout="@layout/fragment_host_final">
        <argument
            android:name="eventId"
            app:argType="string"/>
        <argument
            android:name="eventTitle"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <action
            android:id="@+id/action_host_final_organizer_side_to_organizerDashboardFragment"
            app:destination="@id/nav_organizer_home"
            app:popUpTo="@id/nav_organizer_home"
            app:popUpToInclusive="true"/>
    </fragment>

    <!-- CORRECT, SINGLE DEFINITION for OrganizerApplicationsFragment -->
    <fragment
        android:id="@+id/nav_organizer_applications"
        android:name="com.example.volunteersApp.organizer.OrganizerApplicationsFragment"
        android:label="@string/title_view_applications"
        tools:layout="@layout/fragment_organizer_applications" >
        <argument
            android:name="eventId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />

        <argument
            android:name="organizerId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />

        <action
            android:id="@+id/action_organizerApplicationsFragment_to_applicationDetailFragment"
            app:destination="@id/applicationDetailFragment" />
    </fragment>

    <!-- CORRECT, SINGLE DEFINITION for ApplicationDetailFragment with eventId -->
    <fragment
        android:id="@+id/applicationDetailFragment"
        android:name="com.example.volunteersApp.organizer.ApplicationDetailFragment"
        android:label="@string/title_application_details"
        tools:layout="@layout/fragment_application_detail">
        <argument
            android:name="applicationId"
            app:argType="string" />
        <argument
            android:name="eventId"
            app:argType="string" />
        <action
            android:id="@+id/action_applicationDetailFragment_to_organizerApplicationsFragment"
            app:destination="@id/nav_organizer_applications"
            app:popUpTo="@id/nav_organizer_applications"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/nav_organizer_profile"
        android:name="com.example.volunteersApp.organizer.OrganizerProfileFragment"
        android:label="@string/title_organizer_profile"
        tools:layout="@layout/fragment_organizer_profile" />

    <fragment
        android:id="@+id/nav_organizer_activity_summary"
        android:name="com.example.volunteersApp.organizer.OrganizerActivitySummaryFragment"
        android:label="@string/title_activity_summary"
        tools:layout="@layout/fragment_organizer_activity_summary" />



