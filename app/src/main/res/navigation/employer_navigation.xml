<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/employer_navigation"
    app:startDestination="@id/startStreamActivity_employer">

    <!--
    The <fragment> destinations that were previously defined in this file have been
    removed. Their functionality has been migrated to Jetpack Compose screens,
    and the navigation is now handled within a Compose NavHost.

    This file is kept to define <activity> destinations that can be launched from
    the employer workflow.
    -->

    <!-- =============================================================== -->
    <!-- LIVE STREAMING ACTIVITY DEFINITIONS                           -->
    <!-- =============================================================== -->
    <activity
        android:id="@+id/startStreamActivity_employer"
        android:name="com.example.volunteersApp.streams.StartStreamActivity"
        android:label="@string/title_start_stream" />

    <activity
        android:id="@+id/liveStreamActivity_employer"
        android:name="com.example.volunteersApp.streams.LiveStreamActivity"
        android:label="@string/title_live_stream">
        <argument
            android:name="CHANNEL_NAME"
            app:argType="string" />
        <argument
            android:name="IS_HOST"
            app:argType="boolean"
            android:defaultValue="false" />
    </activity>
    <!-- =============================================================== -->

</navigation>
