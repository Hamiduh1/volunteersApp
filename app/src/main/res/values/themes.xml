<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Base application theme for LIGHT mode.
        This theme DOES NOT have an ActionBar by default because its parent is NoActionBar.
        Activities that need their own Toolbar should use this theme or one derived from it.
    -->
    <style name="Base.Theme.VolunteersApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Light Theme Color Attributes -->
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_light_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_light_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_theme_light_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_light_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_light_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_light_onTertiaryContainer</item>
        <item name="colorError">@color/md_theme_light_error</item>
        <item name="colorOnError">@color/md_theme_light_onError</item>
        <item name="colorErrorContainer">@color/md_theme_light_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_light_onErrorContainer</item>
        <item name="android:colorBackground">@color/md_theme_light_background</item>
        <item name="colorOnBackground">@color/md_theme_light_onBackground</item>
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>
        <item name="colorSurfaceInverse">@color/md_theme_dark_surface</item>
        <item name="colorOnSurfaceInverse">@color/md_theme_dark_onSurface</item>
        <item name="colorOutline">@color/md_theme_light_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_light_outlineVariant</item>
        <item name="scrimBackground">@color/md_theme_light_scrim</item>
         <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>


         <item name="colorPrimaryVariant">@color/purple_700</item>
         <!-- Secondary brand color. -->
         <item name="colorSecondaryVariant">@color/teal_700</item>
         <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>

    </style>

    <!-- Final application theme (No ActionBar variant) -->
    <style name="Theme.VolunteersApp" parent="Base.Theme.VolunteersApp" />

    <!--
        Theme for Activities that REQUIRE a default ActionBar provided by the theme.
        This theme explicitly ENABLES the ActionBar.
    -->
    <style name="Theme.VolunteersApp.WithActionBar" parent="Theme.Material3.DayNight">
        <!--
            This parent provides an ActionBar.
            Copy relevant color attributes from Base.Theme.VolunteersApp if you want consistency.
        -->
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_light_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_light_onSecondaryContainer</item>
        <!-- ... and so on for other relevant color attributes ... -->

        <!-- Status bar customization for ActionBar theme -->
        <!-- Use colorPrimary for the status bar if the ActionBar is also primary colored -->
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item> <!-- true if colorPrimary is light, false if dark -->

        <!-- These ensure the ActionBar is shown by the theme -->
        <!-- <item name="windowActionBar">true</item> No need, parent Theme.Material3.DayNight does this -->
        <!-- <item name="windowNoTitle">false</item> No need, parent Theme.Material3.DayNight does this -->
    </style>

    <!-- Your Widget Styles (can remain here or move to a separate styles.xml for widgets) -->
    <style name="Widget.App.RadioButton" parent="Widget.MaterialComponents.CompoundButton.RadioButton">
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:minHeight">48dp</item>
    </style>











        <!-- Theme for Activities that use their own Toolbar instead of the default ActionBar -->
        <style name="Theme.VolunteersApp.NoActionBar" parent="Theme.VolunteersApp">
            <item name="windowActionBar">false</item>
            <item name="windowNoTitle">true</item>
        </style>

        <!-- AppBarOverlay: Used for theming the AppBarLayout itself -->
        <!-- It often makes the AppBar text and icons dark if the AppBar background is light,
             or light if the AppBar background is dark. -->
        <style name="Theme.VolunteersApp.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
            <!-- You can customize attributes here if needed.
                 For example, to change the color of the title text in the Toolbar:
            <item name="android:textColorPrimary">@color/your_appbar_text_color</item>
                 To change the color of icons (like back arrow, overflow menu icon):
            <item name="colorControlNormal">@color/your_appbar_icon_color</item>
            -->
        </style>

        <!-- PopupOverlay: Used for theming popup menus (e.g., the overflow menu) -->
        <!-- It often ensures the popup background is light and text is dark. -->
        <style name="Theme.VolunteersApp.PopupOverlay" parent="ThemeOverlay.AppCompat.Light">
            <!-- You can customize attributes here if needed.
                 For example, to change the background of the popup menu:
            <item name="android:background">@color/your_popup_background_color</item>
                 To change the text color in the popup menu:
            <item name="android:textColorPrimary">@color/popup_text_color</item>
            -->
        </style>




</resources>
