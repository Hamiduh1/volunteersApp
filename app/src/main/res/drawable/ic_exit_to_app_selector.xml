<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- For action items like sign out, usually the selected state is less emphasized -->
    <!-- You might even use the same icon for default and selected state -->
    <item android:drawable="@drawable/ic_exit_to_app_selected" android:state_selected="true" />
    <item android:drawable="@drawable/ic_exit_to_app_selected" android:state_checked="true" />
    <item android:drawable="@drawable/ic_exit_to_app_default" />
</selector>
