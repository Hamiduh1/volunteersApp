<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <!-- Background color of the chip/view -->
            <solid android:color="#E0E0E0" /> <!-- Light Gray, choose your color -->

            <!-- Rounded corners -->
            <corners android:radius="16dp" /> <!-- Adjust radius as needed -->

            <!-- Optional: Padding inside the shape -->
            <padding
                android:left="8dp"
                android:top="4dp"
                android:right="8dp"
                android:bottom="4dp" />

            <!-- Optional: Border -->
            <!--
            <stroke
                android:width="1dp"
                android:color="#BDBDBD" />
            -->
        </shape>
    </item>

    <!-- Example: If you wanted a different look when pressed (add this if needed) -->
    <!--
