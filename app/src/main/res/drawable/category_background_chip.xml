        <shape android:shape="rectangle">
            <solid android:color="#BDBDBD" />
            <corners android:radius="16dp" />
            <padding
                android:left="8dp"
                android:top="4dp"
                android:right="8dp"
                android:bottom="4dp" />
        </shape>
    </item>
    -->

</selector>