<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Define the solid color of the background -->
    <solid android:color="#D32F2F" /> <!-- Example: A shade of red for "closed" status -->
    <!-- Choose a color that represents "closed" for your app -->
    <!-- Common choices: Red, Gray, Orange -->

    <!-- Optional: Add rounded corners -->
    <corners android:radius="8dp" /> <!-- Adjust radius as needed -->

    <!-- Optional: Add a border -->
    <!--
    <stroke
        android:width="1dp"
        android:color="#A00000" />
    -->

    <!-- Optional: Add padding if you want space between the text and the background edges -->
    <padding
        android:left="10dp"
        android:top="5dp"
        android:right="10dp"
        android:bottom="5dp"/>
</shape>