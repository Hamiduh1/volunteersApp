<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
<item>
    <shape android:shape="rectangle">
        <solid android:color="@android:color/transparent" />
        <corners android:radius="8dp" />
        <stroke android:width="1dp" android:color="?attr/colorControlNormal" />
    </shape>
</item>
<item android:gravity="center_vertical|end" android:right="8dp">
    <bitmap android:src="@drawable/ic_arrow_drop_down"
        android:gravity="center"
        android:tint="?attr/colorControlNormal" /> <!-- The tint here will also apply -->
</item>
</layer-list>