<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Icon when the item is checked/selected -->
    <item android:drawable="@drawable/ic_home_active" android:state_checked="true"/>
    <!-- Default icon (when item is not checked/selected) -->
    <item android:drawable="@drawable/ic_home_inactive" android:state_checked="false"/>
    <!-- Fallback if no other state matches (optional, but good practice) -->
    <item android:drawable="@drawable/ic_home_inactive"/>
</selector>
