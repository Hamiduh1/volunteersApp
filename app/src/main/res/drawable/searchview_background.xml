<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- State when the SearchView is focused (user clicked into it) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" /> <!-- White background when focused -->
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="?attr/colorPrimary" /> <!-- Border with primary color when focused -->
        </shape>
    </item>

    <!-- Default state (not focused) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F5F5F5" /> <!-- Light gray background by default -->
            <corners android:radius="24dp" />
            <!-- Optional: Default border -->
            <!--
            <stroke
                android:width="1dp"
                android:color="#E0E0E0" />
            -->
        </shape>
    </item>

</selector>