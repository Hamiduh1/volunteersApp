<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle"> <!-- It's good practice to specify android:shape -->
            <gradient
                android:angle="90"
                android:endColor="#B3BBCC"
                android:startColor="#E8EBEF"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#000000" />
            <corners
                android:radius="4dp" />
            <padding
                android:bottom="3dp"
                android:left="3dp"
                android:right="3dp"
                android:top="3dp" />
        </shape>
    </item>
</layer-list>
