<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- The solid color of the chip background.
         Using an attribute from your theme (like colorSecondary) allows it
         to adapt to your app's theming.
         You can also use a hardcoded color like android:color="#E0E0E0" (a light gray) -->
    <solid android:color="?attr/colorSecondary" />

    <!-- Defines the roundness of the corners.
         Adjust the radius to make it more or less rounded. -->
    <corners android:radius="12dp" />

    <!-- Optional: Add a stroke (border) if desired
    <stroke
        android:width="1dp"
        android:color="?attr/colorPrimary" />
    -->

    <!-- Optional: Add padding if the TextView itself doesn't have enough
    <padding
        android:left="8dp"
        android:top="4dp"
        android:right="8dp"
        android:bottom="4dp" />
    -->

</shape>
