<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background Color -->
    <solid android:color="@color/my_message_bubble_color" />
    <!-- Define this color in your colors.xml, e.g., <color name="my_message_bubble_color">#007AFF</color> (a nice iOS-like blue)
         or use a predefined Android color like @android:color/holo_blue_light -->

    <!-- Rounded Corners -->
    <corners
        android:radius="16dp" />
    <!-- You can also specify individual corners if needed, e.g.,
    android:topLeftRadius="16dp"
    android:topRightRadius="16dp"
    android:bottomLeftRadius="16dp"
    android:bottomRightRadius="0dp"  // Example for a tail effect
    -->

    <!-- Optional: Padding inside the bubble (alternative to padding on the TextView itself) -->
    <!--
    <padding
        android:left="12dp"
        android:top="8dp"
        android:right="12dp"
        android:bottom="8dp" />
    -->
</shape>