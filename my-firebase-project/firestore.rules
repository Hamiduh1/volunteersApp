rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- SECURITY FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOrganizer() {
      return exists(/databases/$(database)/documents/organizers/$(request.auth.uid));
    }

    function isEmployer() {
      return exists(/databases/$(database)/documents/employers/$(request.auth.uid));
    }

    function isWalletAgent() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'agent';
    }

    function isPlatformOwner() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    function isPlatformAdmin() {
      return isSignedIn() && (
        request.auth.token.owner == true ||
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner', 'admin']
      );
    }

    function isApplicationOwnerFromData(data) {
      return ('userId' in data && data.userId == request.auth.uid) ||
        ('volunteerUid' in data && data.volunteerUid == request.auth.uid) ||
        ('volunteerId' in data && data.volunteerId == request.auth.uid);
    }

    function isApplicationManagerFromData(data) {
      return ('organizerId' in data && data.organizerId == request.auth.uid) ||
        ('organizerUid' in data && data.organizerUid == request.auth.uid) ||
        ('employerUid' in data && data.employerUid == request.auth.uid) ||
        ('employerId' in data && data.employerId == request.auth.uid);
    }

    // call_sessions: 1:1 uses callerId/receiverId; groups use participantIds (may omit receiverId).
    // Use map keys explicitly so missing fields do not coerce awkwardly under .get defaults.
    function isCallSessionParticipant(data) {
      return isSignedIn() && (
        ('callerId' in data && data.callerId is string && request.auth.uid == data.callerId) ||
        ('receiverId' in data && data.receiverId is string && request.auth.uid == data.receiverId) ||
        ('participantIds' in data && data.participantIds is list && request.auth.uid in data.participantIds)
      );
    }

    function isCallSessionChatMember(data) {
      let chatId = data.get('chatId', '');
      let participants = chatId is string && chatId != ''
        ? get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', [])
        : [];
      return participants is list && request.auth.uid in participants;
    }

    // iOS parity: group if chatType=group OR more than two participants; else direct.
    function isGroupChatData(data) {
      return data.get('chatType', '') == 'group' ||
        (data.get('participants', []) is list && data.get('participants', []).size() > 2);
    }

    // Message history: participants only; exited members lose group history (not inbox chat doc).
    function canReadChatHistory(chatId) {
      let chat = chatDocData(chatId);
      let participants = chat.get('participants', []);
      let exited = chat.get('exitedParticipantIds', []);
      return isSignedIn() &&
        participants is list &&
        request.auth.uid in participants &&
        (
          !isGroupChatData(chat) ||
          !(exited is list && request.auth.uid in exited)
        );
    }

    function chatDocData(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data;
    }

    // Order-insensitive equality for chat participants (strict == fails when arrays are reordered).
    function chatParticipantListUnchanged() {
      let before = resource.data.get('participants', []);
      let after = request.resource.data.get('participants', []);
      return before is list && after is list &&
        before.size() == after.size() &&
        before.hasAll(after) &&
        after.hasAll(before);
    }

    // Call flows may update any non-empty subset of lastCall* fields (see CallSessionViewModel.acceptSession).
    function chatLastCallMetadataOnlyUpdate() {
      let allowed = [
        'lastCallType',
        'lastCallStatus',
        'lastCallTimestamp',
        'lastCallInitiatorId',
        'lastCallReceiverId'
      ];
      let delta = request.resource.data.diff(resource.data).affectedKeys();
      return delta.size() > 0 && delta.hasOnly(allowed);
    }

    function chatParticipantContentOnlyUpdate() {
      let allowed = [
        'participants',
        'exitedParticipantIds',
        'groupName',
        'groupPhotoUrl',
        'lastMessage',
        'lastMessageText',
        'lastMessageTimestamp',
        'lastMessageId',
        'lastMessageSenderId',
        'lastMessageType',
        'lastMessageDelivered',
        'lastMessageRead',
        'updatedAt',
        'lastCallType',
        'lastCallStatus',
        'lastCallTimestamp',
        'lastCallInitiatorId',
        'lastCallReceiverId'
      ];
      let delta = request.resource.data.diff(resource.data).affectedKeys();
      return delta.size() > 0 &&
        delta.hasOnly(allowed) &&
        request.resource.data.get('chatId', null) == resource.data.get('chatId', null) &&
        request.resource.data.get('chatType', null) == resource.data.get('chatType', null) &&
        request.resource.data.get('groupCreatorId', null) == resource.data.get('groupCreatorId', null) &&
        request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
    }

    function callSessionParticipantUpdateAllowed() {
      let allowed = [
        'acceptedParticipantIds',
        'declinedParticipantIds',
        'endedParticipantIds',
        'status',
        'updatedAt'
      ];
      let delta = request.resource.data.diff(resource.data).affectedKeys();
      return delta.size() > 0 &&
        delta.hasOnly(allowed) &&
        request.resource.data.get('acceptedParticipantIds', []) is list &&
        request.resource.data.get('declinedParticipantIds', []) is list &&
        request.resource.data.get('endedParticipantIds', []) is list &&
        request.resource.data.get('status', resource.data.get('status', 'ringing')) in ['ringing', 'accepted', 'declined', 'ended'] &&
        request.resource.data.get('chatId', null) == resource.data.get('chatId', null) &&
        request.resource.data.get('callerId', null) == resource.data.get('callerId', null) &&
        request.resource.data.get('receiverId', null) == resource.data.get('receiverId', null) &&
        request.resource.data.get('participantIds', []) == resource.data.get('participantIds', []) &&
        request.resource.data.get('callType', null) == resource.data.get('callType', null) &&
        request.resource.data.get('isGroup', null) == resource.data.get('isGroup', null) &&
        request.resource.data.get('groupName', null) == resource.data.get('groupName', null) &&
        request.resource.data.get('callerName', null) == resource.data.get('callerName', null) &&
        request.resource.data.get('callerPhotoUrl', null) == resource.data.get('callerPhotoUrl', null) &&
        request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
    }

    function callSessionCreateAllowed() {
      let chatId = request.resource.data.get('chatId', '');
      let callerId = request.resource.data.get('callerId', '');
      let receiverId = request.resource.data.get('receiverId', '');
      let participantIds = request.resource.data.get('participantIds', []);
      let accepted = request.resource.data.get('acceptedParticipantIds', []);
      let declined = request.resource.data.get('declinedParticipantIds', []);
      let ended = request.resource.data.get('endedParticipantIds', []);
      let callType = request.resource.data.get('callType', '');
      let status = request.resource.data.get('status', '');
      let chat = chatDocData(chatId);

      return isSignedIn() &&
        chatId is string &&
        chatId != '' &&
        callerId is string &&
        callerId == request.auth.uid &&
        chat.participants is list &&
        request.auth.uid in chat.participants &&
        participantIds is list &&
        participantIds.size() >= 1 &&
        chat.participants.hasAll(participantIds) &&
        receiverId is string &&
        (receiverId == '' || receiverId in chat.participants) &&
        callType is string &&
        (callType == 'audio' || callType == 'video') &&
        status == 'ringing' &&
        accepted is list &&
        request.auth.uid in accepted &&
        declined is list &&
        ended is list &&
        !(request.auth.uid in declined) &&
        !(request.auth.uid in ended);
    }

    function callLogParticipantUpdateAllowed(chatId) {
      let allowed = [
        'status',
        'endedAt',
        'durationSeconds',
        'participantIds',
        'isGroupCall',
        'groupName'
      ];
      let delta = request.resource.data.diff(resource.data).affectedKeys();
      let participants = request.resource.data.get('participantIds', []);
      let chat = chatDocData(chatId);
      return delta.size() > 0 &&
        delta.hasOnly(allowed) &&
        request.resource.data.get('chatId', null) == resource.data.get('chatId', null) &&
        request.resource.data.get('callerId', null) == resource.data.get('callerId', null) &&
        request.resource.data.get('receiverId', null) == resource.data.get('receiverId', null) &&
        request.resource.data.get('callType', null) == resource.data.get('callType', null) &&
        request.resource.data.get('startedAt', null) == resource.data.get('startedAt', null) &&
        participants is list &&
        chat.participants is list &&
        chat.participants.hasAll(participants);
    }

    function hiddenMindLoomStatuses() {
      return ['DELETED', 'REMOVED', 'INACTIVE', 'REJECTED', 'HIDDEN', 'ARCHIVED', 'CLOSED', 'DISABLED'];
    }

    function isVisibleMindLoomData(data) {
      return (!('isDeleted' in data) || data.isDeleted != true) &&
        (!('status' in data) || !(data.status in hiddenMindLoomStatuses()));
    }

    function isValidMindLoomPostCreate(userId) {
      return isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'authorId',
          'authorName',
          'authorProfileUrl',
          'text',
          'mediaUrl',
          'mediaType',
          'liveSessionId',
          'sourceLiveSessionId',
          'sourceLiveHostId',
          'sourceLiveShareUrl',
          'sourceReplayVisibility',
          'status',
          'isDeleted',
          'likes',
          'commentsCount',
          'timestamp'
        ])
        && request.resource.data.keys().hasAll([
          'authorId',
          'authorName',
          'text',
          'mediaType',
          'likes',
          'commentsCount',
          'timestamp'
        ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == userId
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 120
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 5000
        && request.resource.data.mediaType in ['TEXT', 'IMAGE', 'VIDEO', 'DOCUMENT', 'LIVE_SESSION', 'LIVE_REPLAY']
        && (
          (request.resource.data.mediaType == 'TEXT' &&
            (!('mediaUrl' in request.resource.data) || request.resource.data.mediaUrl == null)) ||
          (request.resource.data.mediaType in ['IMAGE', 'VIDEO', 'DOCUMENT'] &&
            request.resource.data.mediaUrl is string &&
            request.resource.data.mediaUrl.size() > 0 &&
            request.resource.data.mediaUrl.size() <= 2048) ||
          (request.resource.data.mediaType in ['LIVE_SESSION', 'LIVE_REPLAY'] &&
            request.resource.data.mediaUrl is string &&
            request.resource.data.mediaUrl.size() > 0 &&
            request.resource.data.mediaUrl.size() <= 2048 &&
            ('liveSessionId' in request.resource.data) &&
            request.resource.data.liveSessionId is string &&
            request.resource.data.liveSessionId.size() > 0 &&
            request.resource.data.liveSessionId.size() <= 128)
        )
        && (!('authorProfileUrl' in request.resource.data) ||
          request.resource.data.authorProfileUrl == null ||
          (request.resource.data.authorProfileUrl is string &&
            request.resource.data.authorProfileUrl.size() <= 2048))
        && (!('liveSessionId' in request.resource.data) ||
          (request.resource.data.liveSessionId is string &&
            request.resource.data.liveSessionId.size() > 0 &&
            request.resource.data.liveSessionId.size() <= 128))
        && (!('sourceLiveSessionId' in request.resource.data) ||
          (request.resource.data.sourceLiveSessionId is string &&
            request.resource.data.sourceLiveSessionId.size() <= 128))
        && (!('sourceLiveHostId' in request.resource.data) ||
          (request.resource.data.sourceLiveHostId is string &&
            request.resource.data.sourceLiveHostId.size() <= 128))
        && (!('sourceLiveShareUrl' in request.resource.data) ||
          (request.resource.data.sourceLiveShareUrl is string &&
            request.resource.data.sourceLiveShareUrl.size() <= 2048))
        && (!('sourceReplayVisibility' in request.resource.data) ||
          (request.resource.data.sourceReplayVisibility in [
            'owner_only', 'shared_link', 'followers_only', 'public'
          ]))
        && (!('status' in request.resource.data) || request.resource.data.status == 'ACTIVE')
        && (!('isDeleted' in request.resource.data) || request.resource.data.isDeleted == false)
        && request.resource.data.likes is list
        && request.resource.data.likes.size() == 0
        && request.resource.data.commentsCount == 0
        && request.resource.data.timestamp == request.time;
    }

    function isValidMindLoomOwnerTextUpdate(userId) {
      return isOwner(userId)
        && resource.data.authorId == userId
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 5000;
    }

    function isValidMindLoomLikeUpdate() {
      return isSignedIn()
        && isVisibleMindLoomData(resource.data)
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && resource.data.likes is list
        && request.resource.data.likes is list
        && (
          (
            !(request.auth.uid in resource.data.likes) &&
            request.auth.uid in request.resource.data.likes &&
            request.resource.data.likes.size() == resource.data.likes.size() + 1 &&
            request.resource.data.likes.hasAll(resource.data.likes)
          ) ||
          (
            request.auth.uid in resource.data.likes &&
            !(request.auth.uid in request.resource.data.likes) &&
            request.resource.data.likes.size() == resource.data.likes.size() - 1 &&
            resource.data.likes.hasAll(request.resource.data.likes)
          )
        );
    }

    function isValidMindLoomCommentCreate(postOwnerId) {
      return isSignedIn()
        && request.resource.data.keys().hasOnly([
          'authorId',
          'authorUid',
          'authorName',
          'authorProfileUrl',
          'text',
          'isOwnerResponse',
          'timestamp'
        ])
        && request.resource.data.keys().hasAll(['authorId', 'authorName', 'text', 'timestamp'])
        && request.resource.data.authorId == request.auth.uid
        && (!('authorUid' in request.resource.data) || request.resource.data.authorUid == request.auth.uid)
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 120
        && (!('authorProfileUrl' in request.resource.data) ||
          request.resource.data.authorProfileUrl == null ||
          (request.resource.data.authorProfileUrl is string &&
            request.resource.data.authorProfileUrl.size() <= 2048))
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && (!('isOwnerResponse' in request.resource.data) ||
          request.resource.data.isOwnerResponse == false ||
          request.auth.uid == postOwnerId)
        && request.resource.data.timestamp == request.time;
    }

    function isValidMindLoomSavedPostWrite() {
      return request.resource.data.keys().hasOnly(['authorId', 'savedAt'])
        && request.resource.data.keys().hasAll(['authorId', 'savedAt'])
        && request.resource.data.authorId is string
        && request.resource.data.authorId.size() > 0
        && request.resource.data.savedAt == request.time;
    }

    function isValidFollowEdgeCreate(edgeUserId) {
      return isSignedIn()
        && request.auth.uid == edgeUserId
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
    }

    function isValidChatInvitationCreate(senderId) {
      return isSignedIn()
        && request.auth.uid == senderId
        && request.resource.data.keys().hasOnly([
          'senderId',
          'senderName',
          'inviterName',
          'senderProfilePicUrl',
          'senderProfileImageUrl',
          'status',
          'timestamp',
          'context'
        ])
        && request.resource.data.keys().hasAll(['senderId', 'status', 'timestamp', 'context'])
        && request.resource.data.senderId == senderId
        && request.resource.data.status == 'pending'
        && request.resource.data.timestamp == request.time
        && request.resource.data.context is string
        && request.resource.data.context.size() > 0
        && request.resource.data.context.size() <= 500
        && (
          ('senderName' in request.resource.data &&
            request.resource.data.senderName is string &&
            request.resource.data.senderName.size() > 0 &&
            request.resource.data.senderName.size() <= 120) ||
          ('inviterName' in request.resource.data &&
            request.resource.data.inviterName is string &&
            request.resource.data.inviterName.size() > 0 &&
            request.resource.data.inviterName.size() <= 120)
        )
        && (!('senderProfilePicUrl' in request.resource.data) ||
          request.resource.data.senderProfilePicUrl == null ||
          (request.resource.data.senderProfilePicUrl is string &&
            request.resource.data.senderProfilePicUrl.size() <= 2048))
        && (!('senderProfileImageUrl' in request.resource.data) ||
          request.resource.data.senderProfileImageUrl == null ||
          (request.resource.data.senderProfileImageUrl is string &&
            request.resource.data.senderProfileImageUrl.size() <= 2048));
    }

    function isValidChatInvitationRecipientUpdate(userId) {
      return isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastUpdatedAt'])
        && request.resource.data.status in ['accepted', 'declined', 'rejected']
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastUpdatedAt']) ||
          request.resource.data.lastUpdatedAt == request.time);
    }

    function isDatingEligibleAccount(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && isDatingEligibleUserData(get(/databases/$(database)/documents/users/$(userId)).data);
    }

    function isDatingEligibleUserData(userData) {
      return (
        !('profileStatus' in userData) ||
        !(userData.profileStatus is string) ||
        userData.profileStatus.matches('(?i)^active$')
      ) && (
        (('canAccessDating' in userData) && userData.canAccessDating == true) ||
        (!('canAccessDating' in userData) &&
          ('isMinor' in userData) &&
          userData.isMinor == false)
      );
    }

    function isBlindDateProfileActive(userId) {
      return exists(/databases/$(database)/documents/blindDateProfiles/$(userId))
        && get(/databases/$(database)/documents/blindDateProfiles/$(userId)).data.status == 'active';
    }

    function blindDatePreferenceAcceptsGender(preference, gender) {
      return preference == 'EVERYONE' ||
        (preference == 'MEN' && gender == 'MALE') ||
        (preference == 'WOMEN' && gender == 'FEMALE');
    }

    function isBlindDatePreferenceCompatible(senderId, recipientId) {
      let sender = get(/databases/$(database)/documents/blindDateProfiles/$(senderId)).data;
      let recipient = get(/databases/$(database)/documents/blindDateProfiles/$(recipientId)).data;
      return blindDatePreferenceAcceptsGender(
        sender.get('lookingFor', 'EVERYONE'),
        recipient.get('gender', 'OTHER')
      ) && blindDatePreferenceAcceptsGender(
        recipient.get('lookingFor', 'EVERYONE'),
        sender.get('gender', 'OTHER')
      );
    }

    function hasDatingBlock(blockerId, targetId) {
      let privacyPath = /databases/$(database)/documents/users/$(blockerId)/settings/chat_privacy;
      return exists(privacyPath) && targetId in get(privacyPath).data.get('blockedUserIds', []);
    }

    function isValidBlindDateInvitePayload(senderId, recipientId) {
      return request.resource.data.keys().hasOnly([
          'senderId',
          'senderName',
          'senderProfilePictureUrl',
          'recipientId',
          'recipientName',
          'recipientProfilePictureUrl',
          'status',
          'matchedChatId',
          'sentAt',
          'updatedAt',
          'respondedAt'
        ])
        && request.resource.data.keys().hasAll([
          'senderId',
          'recipientId',
          'status',
          'matchedChatId',
          'sentAt',
          'updatedAt'
        ])
        && request.resource.data.senderId == senderId
        && request.resource.data.recipientId == recipientId
        && request.resource.data.status == 'pending'
        && request.resource.data.matchedChatId == ''
        && request.resource.data.sentAt == request.time
        && request.resource.data.updatedAt == request.time
        && (!('respondedAt' in request.resource.data) || request.resource.data.respondedAt == null)
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() > 0
        && request.resource.data.senderName.size() <= 120
        && request.resource.data.recipientName is string
        && request.resource.data.recipientName.size() > 0
        && request.resource.data.recipientName.size() <= 120
        && request.resource.data.senderProfilePictureUrl is string
        && request.resource.data.senderProfilePictureUrl.size() <= 2048
        && request.resource.data.recipientProfilePictureUrl is string
        && request.resource.data.recipientProfilePictureUrl.size() <= 2048;
    }

    function isValidBlindDateInvitationCreate(recipientUserId, senderUserId) {
      return isSignedIn()
        && request.auth.uid == senderUserId
        && recipientUserId != senderUserId
        && isDatingEligibleAccount(senderUserId)
        && isDatingEligibleAccount(recipientUserId)
        && isBlindDateProfileActive(senderUserId)
        && isBlindDateProfileActive(recipientUserId)
        && isBlindDatePreferenceCompatible(senderUserId, recipientUserId)
        && !hasDatingBlock(senderUserId, recipientUserId)
        && !hasDatingBlock(recipientUserId, senderUserId)
        && isValidBlindDateInvitePayload(senderUserId, recipientUserId);
    }

    function userProfileChangedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isSafeUserProfileUpdate() {
      return userProfileChangedKeys().hasOnly([
        'name',
        'username',
        'phone',
        'phoneNumber',
        'email',
        'emailVerified',
        'profileImageUrl',
        'profilePictureUrl',
        'country',
        'bio',
        'organizationName',
        'datingContactPhone',
        'fcmToken',
        // Presence is client-authored status only; it cannot change roles or wallet data.
        'presenceState',
        'lastActiveAt',
        'updatedAt'
      ])
        && (!userProfileChangedKeys().hasAny(['datingContactPhone']) ||
          (request.resource.data.datingContactPhone is string &&
            request.resource.data.datingContactPhone.size() >= 7 &&
            request.resource.data.datingContactPhone.size() <= 32));
    }

    function isInitialWalletBootstrap() {
      return userProfileChangedKeys().hasOnly(['wallet'])
        && !('wallet' in resource.data)
        && request.resource.data.wallet is map
        && request.resource.data.wallet.balance == 0
        && request.resource.data.wallet.currency is string;
    }

    // --- DEPOSIT REQUESTS ---
    match /deposit_requests/{requestId} {
      allow create: if false;
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isWalletAgent() || isPlatformAdmin();
      allow update: if false;
      allow delete: if false;
    }

    match /wallets/{userId} {
      allow get: if isOwner(userId) || isWalletAgent() || isPlatformAdmin();
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /provider_transactions/{transactionId} {
      allow read, create, update, delete: if false;
    }

    match /provider_webhooks/{webhookId} {
      allow read, create, update, delete: if false;
    }

    // --- USER-SPECIFIC DATA ---
    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isOwner(userId)
        && request.resource.data.role in ['user', 'organizer', 'employer', 'volunteer']
        && request.resource.data.wallet.balance == 0;

      allow update: if
        (
          isOwner(userId) &&
          (
            isSafeUserProfileUpdate() ||
            isInitialWalletBootstrap()
          )
        );

      // --- SUB-COLLECTION RULES ---
      match /transactions/{transactionId} {
        allow create, update, delete: if false;
        allow read: if isOwner(userId);
      }

      match /blindDateInvitations/{invitationId} {
        allow create: if isValidBlindDateInvitationCreate(userId, invitationId);
        allow read: if request.auth.uid == userId;
        allow update, delete: if false;
      }

      match /blindDateSentInvitations/{recipientId} {
        allow create: if isValidBlindDateInvitationCreate(recipientId, userId);
        allow read: if request.auth.uid == userId;
        allow update, delete: if false;
      }

      match /hostedEvents/{eventId} {
        allow read, write: if isOwner(userId);
      }

      match /beneficiaries/{phone} {
        allow read, delete: if isOwner(userId);
        // Creation and updates are server-owned so provider-verification fields
        // cannot be forged from an Android client.
        allow create, update: if false;
      }

      match /payment_methods/{methodId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if false;
        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.writeFields.hasOnly(['isDefault']);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Literal path: any authenticated user may read (mutual block checks for calls/chats).
      match /settings/chat_privacy {
        allow read: if request.auth != null;
        allow write: if isOwner(userId);
      }

      match /settings/{settingId} {
        allow read: if isSignedIn() && isOwner(userId) && settingId != 'chat_privacy';
        allow write: if isOwner(userId) && settingId != 'chat_privacy';
      }

      match /invitations/{senderId} {
        allow read: if isSignedIn() && (isOwner(userId) || isOwner(senderId));
        allow list: if isSignedIn() && isOwner(userId);
        allow create: if isValidChatInvitationCreate(senderId);
        allow update: if isValidChatInvitationRecipientUpdate(userId);
        allow delete: if isSignedIn() && isOwner(userId);
      }

      // Legacy chat invitation path used by older screens.
      match /chat_invitations/{senderId} {
        allow read: if isSignedIn() && (isOwner(userId) || isOwner(senderId));
        allow list: if isSignedIn() && isOwner(userId);
        allow create: if isValidChatInvitationCreate(senderId);
        allow update: if isValidChatInvitationRecipientUpdate(userId);
        allow delete: if isSignedIn() && isOwner(userId);
      }

      match /jokes/{jokeId} {
        allow read: if isSignedIn() && (isOwner(userId) || isVisibleMindLoomData(resource.data));
        allow create: if isValidMindLoomPostCreate(userId);
        allow update: if isValidMindLoomOwnerTextUpdate(userId) || isValidMindLoomLikeUpdate();
        allow delete: if isOwner(userId) && resource.data.authorId == userId;

        match /comments/{commentId} {
          allow read: if isSignedIn() &&
            (isOwner(userId) ||
              isVisibleMindLoomData(get(/databases/$(database)/documents/users/$(userId)/jokes/$(jokeId)).data));
          allow create: if isValidMindLoomCommentCreate(userId) &&
            isVisibleMindLoomData(get(/databases/$(database)/documents/users/$(userId)/jokes/$(jokeId)).data);
          allow update, delete: if false;
        }
      }

      match /saved_jokes/{jokeId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidMindLoomSavedPostWrite();
        allow delete: if isOwner(userId);
      }

      match /followers/{followerId} {
        allow read: if isSignedIn();
        allow create: if isValidFollowEdgeCreate(followerId);
        allow delete: if isSignedIn() && request.auth.uid == followerId;
        allow update: if false;
      }

      match /following/{followingId} {
        allow read: if isSignedIn();
        allow create: if isValidFollowEdgeCreate(userId);
        allow delete: if isSignedIn() && request.auth.uid == userId;
        allow update: if false;
      }

      match /notifications/{notificationId} {
        allow read, list: if isOwner(userId);
        allow update: if isOwner(userId) && request.writeFields.hasOnly(['read']);
        allow create, delete: if false;
      }

      // Incoming call signaling mirror — CallSessionViewModel listens here (not call_sessions queries).
      match /incoming_call_sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }

      // Denormalized call log feed for Social Inbox Calls tab (iOS CallsRepository primary path).
      match /call_history/{entryId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }

      // Legacy user-scoped feed retained for historical Android call entries.
      match /call_logs/{entryId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }

      // User-hidden call history rows (swipe delete in Calls tab).
      match /call_history_hidden/{hiddenId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

    // --- BLIND DATE RULES ---
    match /blindDateProfiles/{userId} {
      allow read: if isSignedIn() && isDatingEligibleAccount(request.auth.uid);
      allow create: if false;
      allow update: if
        (isOwner(userId) &&
          isDatingEligibleAccount(userId) &&
          !('status' in request.writeFields) &&
          !('userId' in request.writeFields) &&
          !('createdAt' in request.writeFields));
    }

    // --- CHAT RULES ---
    match /chats/{chatId} {
      allow create: if isSignedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() >= 2
        && request.auth.uid in request.resource.data.participants;
      // IMPORTANT: allow reading the chat doc even if the user is marked "exited" or a direct
      // chat later becomes blocked.
      // Otherwise `whereField("participants", arrayContains: uid)` can return a doc that then fails
      // stricter read rules, causing the entire Social Inbox query to fail with permission_denied.
      // Message/call_log subcollections still use canReadChatHistory for exited group members.
      allow read: if isSignedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;
      allow update: if isSignedIn()
        && resource.data.get('participants', []) is list
        && request.auth.uid in resource.data.get('participants', [])
        && (
          (chatParticipantListUnchanged() && chatParticipantContentOnlyUpdate())
          || chatLastCallMetadataOnlyUpdate()
        );

      match /messages/{messageId} {
        allow read: if canReadChatHistory(chatId);
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        // Recipients may update delivery/read fields; senders may soft-delete their own messages.
        allow update: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && (
            (
              resource.data.senderId == request.auth.uid &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'isDeleted',
                'deletedAt',
                'messageText',
                'mediaUrl',
                'storagePath'
              ]) &&
              request.resource.data.isDeleted == true &&
              request.resource.data.messageText == 'Message deleted' &&
              request.resource.data.mediaUrl == null &&
              request.resource.data.storagePath == null
            )
            || (
              request.auth.uid != resource.data.senderId &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'deliveredTo',
                'readBy',
                'isRead'
              ]) &&
              request.resource.data.deliveredTo is list &&
              request.resource.data.readBy is list &&
              request.resource.data.deliveredTo.hasAll(resource.data.deliveredTo) &&
              request.resource.data.readBy.hasAll(resource.data.readBy) &&
              request.auth.uid in request.resource.data.deliveredTo &&
              request.auth.uid in request.resource.data.readBy &&
              request.resource.data.senderId == resource.data.senderId &&
              request.resource.data.senderDisplayName == resource.data.senderDisplayName &&
              request.resource.data.messageText == resource.data.messageText &&
              request.resource.data.messageType == resource.data.messageType &&
              request.resource.data.mediaUrl == resource.data.mediaUrl &&
              request.resource.data.storagePath == resource.data.storagePath &&
              request.resource.data.replyToMessageId == resource.data.replyToMessageId &&
              request.resource.data.replyToText == resource.data.replyToText &&
              request.resource.data.replyToSenderName == resource.data.replyToSenderName &&
              request.resource.data.isDeleted == resource.data.isDeleted &&
              request.resource.data.deletedAt == resource.data.deletedAt
            )
          );
        allow delete: if false;
      }

      match /call_logs/{callId} {
        allow read: if isSignedIn()
          && get(/databases/$(database)/documents/chats/$(chatId)).data.participants is list
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn()
          && get(/databases/$(database)/documents/chats/$(chatId)).data.participants is list
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.callerId == request.auth.uid;
        allow update: if isSignedIn()
          && get(/databases/$(database)/documents/chats/$(chatId)).data.participants is list
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && callLogParticipantUpdateAllowed(chatId);
        allow delete: if false;
      }
    }

    function callSessionStatusIsRinging(data) {
      return data.get('status', '') == 'ringing';
    }

    function callSessionReceiverIsAuthUser(data) {
      return data.get('receiverId', '') is string &&
        data.get('receiverId', '') != '' &&
        data.get('receiverId', '') == request.auth.uid;
    }

    function callSessionParticipantIdsContainAuthUser(data) {
      return data.get('participantIds', []) is list &&
        request.auth.uid in data.get('participantIds', []);
    }

    match /call_sessions/{sessionId} {
      allow get: if isCallSessionParticipant(resource.data);
      // One list rule per query shape (Firestore rejects OR for collection queries):
      // 1:1 incoming — receiverId + status
      allow list: if isSignedIn() &&
        callSessionStatusIsRinging(resource.data) &&
        callSessionReceiverIsAuthUser(resource.data);
      // Group / multi-party — participantIds array-contains + status
      allow list: if isSignedIn() &&
        callSessionStatusIsRinging(resource.data) &&
        callSessionParticipantIdsContainAuthUser(resource.data);
      // Conversation screen — call_sessions by chatId (signaling only; messages stay under chats)
      allow list: if isSignedIn() &&
        resource.data.chatId is string &&
        resource.data.chatId != '' &&
        isCallSessionChatMember(resource.data);
      // Per-chat ringing — chatId + status (optional narrow query)
      allow list: if isSignedIn() &&
        callSessionStatusIsRinging(resource.data) &&
        resource.data.chatId is string &&
        resource.data.chatId != '' &&
        isCallSessionChatMember(resource.data);
      allow create: if callSessionCreateAllowed();
      allow update: if isCallSessionParticipant(resource.data) && callSessionParticipantUpdateAllowed();
      // Participants may remove stale signaling docs (ended/declined); admin SDK used for bulk cleanup.
      allow delete: if isSignedIn() &&
        isCallSessionParticipant(resource.data) &&
        resource.data.get('status', '') in ['ended', 'declined', 'accepted', 'ringing'];
    }

    // --- ORGANIZERS ---
    match /organizers/{organizerId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(organizerId);
      allow delete: if false;
    }

    // --- EMPLOYERS ---
    match /employers/{employerId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(employerId);
      allow delete: if false;
    }

    // --- EVENTS ---
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isOrganizer() && request.resource.data.organizerId == request.auth.uid;
      allow update, delete: if isOrganizer() && resource.data.organizerId == request.auth.uid;
    }

    // --- JOBS ---
    match /jobs/{jobId} {
      allow read: if isSignedIn();
      allow create: if isEmployer() && request.resource.data.employerUid == request.auth.uid;
      allow update, delete: if isEmployer() && resource.data.employerUid == request.auth.uid;
    }

    // --- APPLICATIONS ---
    match /applications/{applicationId} {
      allow read: if isSignedIn() && (
        (isEmployer() && (
          resource.data.employerUid == request.auth.uid ||
          resource.data.employerId == request.auth.uid
        )) ||
        isApplicationOwnerFromData(resource.data)
      );
      allow update: if isEmployer() && (
        resource.data.employerUid == request.auth.uid ||
        resource.data.employerId == request.auth.uid
      );
      allow create: if isSignedIn() && isApplicationOwnerFromData(request.resource.data);
      allow delete: if isSignedIn() && isApplicationOwnerFromData(resource.data);
    }

    match /live_sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.hostId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.hostId == request.auth.uid;
      allow delete: if false;

      match /likes/{userId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.get('chatEnabled', true) == true
          && (
            !('replyToCommentId' in request.resource.data) ||
            (
              request.resource.data.replyToCommentId is string &&
              request.resource.data.replyToCommentId.size() > 0 &&
              request.resource.data.replyToCommentId.size() <= 128
            )
          );
        allow update, delete: if false;
      }

      match /viewers/{userId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && request.auth.uid == userId;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /blocked_users/{blockedUserId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn()
          && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.hostId == request.auth.uid;
      }
    }

    // --- NEW: JOIN LIVE STREAM REQUESTS ---
    match /join_requests/{requestId} {
      // Volunteers can create requests to join streams
      allow create: if isSignedIn() && request.resource.data.volunteerId == request.auth.uid;

      // Users can read their own requests
      allow read: if isSignedIn() && (
        resource.data.volunteerId == request.auth.uid ||
        // Organizers can read requests for their streams
        get(/databases/$(database)/documents/live_sessions/$(resource.data.streamId)).data.hostId == request.auth.uid
      );

      // Only the organizer of the stream can update request status
      allow update: if isSignedIn() && 
        get(/databases/$(database)/documents/live_sessions/$(resource.data.streamId)).data.hostId == request.auth.uid &&
        (request.resource.data.status in ['accepted', 'rejected'] || request.resource.data.status == resource.data.status);

      // No deletion allowed
      allow delete: if false;
    }

    // --- PAYOUT REQUESTS ---
    match /payout_requests/{requestId} {
      allow create: if false;
      allow read: if isWalletAgent() || isPlatformAdmin() || (
        isSignedIn() &&
        (
          resource.data.senderId == request.auth.uid ||
          resource.data.recipientId == request.auth.uid
        )
      );
      allow update: if false;
      allow delete: if false;
    }

    // --- USER REPORTS ---
    // Supports both snake_case and camelCase collections used across screens.
    match /user_reports/{reportId} {
      allow create: if isSignedIn() &&
        (!('reportingUserId' in request.resource.data) || request.resource.data.reportingUserId == request.auth.uid);
      allow read: if isPlatformAdmin() ||
        (isSignedIn() && resource.data.reportingUserId == request.auth.uid);
      allow update, delete: if isPlatformAdmin();
    }

    match /userReports/{reportId} {
      allow create: if isSignedIn() &&
        (
          !('reportingUserId' in request.resource.data) ||
          request.resource.data.reportingUserId == request.auth.uid ||
          ('userId' in request.resource.data && request.resource.data.userId == request.auth.uid)
        );
      allow read: if isPlatformAdmin() ||
        (
          isSignedIn() &&
          (
            resource.data.reportingUserId == request.auth.uid ||
            resource.data.userId == request.auth.uid
          )
        );
      allow update, delete: if isPlatformAdmin();
    }

    // --- SYSTEM / PLATFORM REVENUE ---
    match /system/{docId} {
      // Settlement mirrors contain provider float and operational readiness, not public app data.
      allow read: if isSignedIn() &&
        ((docId != 'platform_revenue' && docId != 'afriex_business_wallet') || isPlatformOwner());
      allow write: if false;

      match /transactions/{txId} {
        allow read: if isPlatformOwner();
        allow write: if false;
      }
    }

    // --- APP CONTENT (READ FOR AUTHENTICATED USERS) ---
    match /general_support_items/{docId} {
      allow read: if isSignedIn();
      allow write: if isPlatformOwner();
    }

    match /howToUseTips/{docId} {
      allow read: if isSignedIn();
      allow write: if isPlatformOwner();
    }

    match /aml_cft_content/{docId} {
      allow read: if isSignedIn();
      allow write: if isPlatformOwner();
    }

    // --- APP CONFIG ---
    // Used by Terms & Conditions / Privacy content shown in-app.
    match /app_config/{docId} {
      allow read: if true;
      allow write: if isPlatformOwner();
    }

    // Legacy alias support in case content exists under camelCase collection.
    match /appConfig/{docId} {
      allow read: if true;
      allow write: if isPlatformOwner();
    }

    // --- MARKETPLACE ---
    match /marketplace_items/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      // Checkout always re-reads the item, but the listing owner itself must
      // also remain immutable so a client cannot redirect a sale to another user.
      allow update: if isSignedIn() &&
        resource.data.sellerId == request.auth.uid &&
        request.resource.data.sellerId == resource.data.sellerId;
      allow delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;
    }

    // --- GALLERY UPLOADS ---
    // iOS/Android shared Gallery feed metadata collection.
    match /galleryUploads/{uploadId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uploaderId == request.auth.uid;
      allow update, delete: if false;
    }

    match /purchase_requests/{requestId} {
      // Retired internal-wallet purchase trigger. Commerce starts only through
      // App Check-protected Stripe Checkout callables.
      allow create: if false;
      allow read: if isSignedIn() && (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId);
      allow update, delete: if false;
    }

    // --- JOKES ---
    // Collection-group compatibility for MindLoom feed (e.g., collectionGroup("jokes")).
    // Keep this read-only; writes stay scoped to /users/{userId}/jokes/{jokeId} above.
    match /{path=**}/jokes/{jokeId} {   
      allow read: if isSignedIn() &&
        (resource.data.authorId == request.auth.uid || isVisibleMindLoomData(resource.data));
    }   

    match /jokes/{jokeId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // --- ADVERTISEMENTS ---
    match /advertisements/{adId} {
      allow read: if isSignedIn();
      // Ad creation + fee debit must happen in Cloud Functions (Admin SDK).
      allow create: if false;
      allow update: if isSignedIn() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // --- GARAGE SALES ---
    match /garage_sales/{saleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if false;
    }

    // Public seller profile metadata used to label and open Garage Shop listings.
    // Payment and order records remain restricted to their participants below.
    match /garage_shop_profiles/{ownerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        ownerId == request.auth.uid &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.shopName is string &&
        request.resource.data.contactName is string &&
        request.resource.data.isOpen is bool &&
        request.resource.data.keys().hasOnly([
          'ownerId', 'shopName', 'contactName', 'isOpen', 'updatedAt'
        ]);
      allow update: if isSignedIn() &&
        ownerId == request.auth.uid &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.shopName is string &&
        request.resource.data.contactName is string &&
        request.resource.data.isOpen is bool &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ownerId', 'shopName', 'contactName', 'isOpen', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /garage_sale_payments/{paymentId} {
      allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
      allow read: if isSignedIn() && (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId);
      allow update, delete: if false;
    }

    // --- DATING LOOP ---
    match /dating_profiles/{userId} {
      allow read: if isSignedIn() && isDatingEligibleAccount(request.auth.uid);
      allow create, update: if isOwner(userId) && isDatingEligibleAccount(userId);
      allow delete: if isOwner(userId);
    }

    // --- APPLICATIONS IN SUBCOLLECTIONS (e.g. events/{eventId}/applications/{appId}) ---
    match /{path=**}/applications/{appId} {
      allow read: if isSignedIn() &&
        (
          isApplicationOwnerFromData(resource.data) ||
          isApplicationManagerFromData(resource.data) ||
          appId == request.auth.uid
        );
      allow create: if isSignedIn() && isApplicationOwnerFromData(request.resource.data);
      allow update: if isSignedIn() && isApplicationManagerFromData(resource.data);
      allow delete: if isSignedIn() &&
        (isApplicationOwnerFromData(resource.data) || isApplicationManagerFromData(resource.data));
    }
  }
}
