# Copy to `.env` for local emulator / testing (see repo root `.gitignore` — `.env` is not committed).
#
# --- Deployed Cloud Functions (project root: `firebase deploy --only functions`) ---
# 1) Put the Auth Key in Secret Manager (name must be exactly `APNS_P8`):
#      cd <repo root>   # directory that contains firebase.json
#      firebase functions:secrets:set APNS_P8 < path/to/AuthKey_XXXXX.p8
#    (Or run `firebase functions:secrets:set APNS_P8` and paste the PEM, then Ctrl+D.)
# 2) In THIS folder, keep a local `.env` with the variables below. The Firebase CLI
#    reads it at deploy time for `defineString` params (`APNS_TEAM_ID`, `APNS_KEY_ID`,
#    `IOS_APP_BUNDLE_ID`, `APNS_USE_SANDBOX`). `APNS_P8` for production comes from the
#    secret above, not from `.env`.
# 3) Grant: first deploy may prompt to enable Secret Manager / IAM for the default
#    compute service account — approve so `onCallSessionCreated` can mount `APNS_P8`.

# -----------------------------------------------------------------------------
# VoIP push (APNs HTTP/2) — used by `notifyIncomingCall` when the callee has
# `apnsVoipToken` in Firestore. Same Apple Auth Key as FCM APNs is fine; reuse
# Key ID, Team ID, and .p8 contents here.
# -----------------------------------------------------------------------------
# iOS app bundle id (must match Xcode PRODUCT_BUNDLE_IDENTIFIER).
IOS_APP_BUNDLE_ID=com.softsolutionstechnologies.volunteersapp.ios

# Apple Developer Team ID (10 characters), not the Key ID.
APNS_TEAM_ID=

# APNs Auth Key ID (e.g. from Apple Developer → Keys).
APNS_KEY_ID=

# Auth Key .p8 ONLY: the file from Apple Developer → Keys → Download (.p8).
# Must start with -----BEGIN PRIVATE KEY----- (PKCS#8). Do NOT use a
# -----BEGIN PUBLIC KEY----- PEM, a .cer, or a push certificate — those cannot
# sign APNs JWTs. Paste with real newlines inside quotes, or one line with \n.
APNS_P8=

# Optional: same values under VOIP-specific names (code falls back to APNS_*).
# APNS_VOIP_TEAM_ID=
# APNS_VOIP_KEY_ID=
# APNS_VOIP_P8=

# Production is the default. Debug devices register their sandbox environment with the server.
APNS_USE_SANDBOX=0

# -----------------------------------------------------------------------------
# Agora RTC (audio/video calls + live rooms)
# -----------------------------------------------------------------------------
# Public Agora App ID used by the callable token function and returned to iOS/Android.
AGORA_APP_ID=

# Agora App Certificate used SERVER-SIDE ONLY to mint RTC tokens.
AGORA_APP_CERTIFICATE=

# Optional token lifetime in seconds. Defaults to 3600.
AGORA_TOKEN_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Hosted wallet / mobile money provider (Afriex)
# -----------------------------------------------------------------------------
# Live mode product shape (transaction_only = no end-customer custody UI).
AFRIEX_LIVE_MODE=transaction_only
AFRIEX_IN_SCOPE_COUNTRY=UG
AFRIEX_IN_SCOPE_CHANNEL=MOBILE_MONEY
AFRIEX_IN_SCOPE_CURRENCY=UGX
# Optional live corridor allowlist for validated payout countries.
# Accepts country names or ISO codes, e.g. UG,KE,GH or Uganda,Kenya,Ghana.
AFRIEX_SUPPORTED_COUNTRIES=BJ,BW,CM,CG,CI,EG,ET,GM,GH,GN,KE,MG,MW,MZ,NG,RW,SN,SL,TZ,UG,ZA,ZM
# Route-specific payout rails currently enabled for this integration.
# Keep mobile-money payout separate from bank payout so bank-only countries do not
# appear in mobile-money recipient pickers.
AFRIEX_MOBILE_MONEY_PAYOUT_COUNTRIES=BJ,BW,CM,CG,CI,ET,GM,GH,GN,KE,MG,MW,MZ,RW,SN,SL,TZ,UG,ZM
# Optional route-code fallback when a provider-approved live directory omits a known code.
# Format: COUNTRY:NETWORK=INSTITUTION_CODE, separated by commas or lines.
AFRIEX_MOBILE_MONEY_INSTITUTION_OVERRIDES=UG:MTN=MTN,UG:AIRTEL=AIRTEL
# Afriex bank payout countries wired for local bank rails. SWIFT-100 expansion
# needs recipient address/invoice fields before customer exposure.
AFRIEX_BANK_PAYOUT_COUNTRIES=US,AT,BE,BG,CM,CN,HR,CY,CZ,CI,DK,EG,EE,ET,FI,FR,DE,GH,GR,HU,IN,IE,IT,KE,LV,LT,LU,MT,NL,NG,NO,PK,PL,PT,RO,RW,SN,SK,SI,ZA,ES,SE,UA,UG,GB
# Local BANK_ACCOUNT institution-list countries. Keep separate from broad bank/SWIFT payout coverage.
# Ghana's listed sandbox banks currently all fail the provider's Alpay connector validation.
AFRIEX_LOCAL_BANK_INSTITUTION_COUNTRIES=NG,GH,KE,ZA,EG
# Sandbox-only safeguard; this does not pause mobile money or a separately configured SWIFT route.
AFRIEX_SANDBOX_BANK_ACCOUNT_UNAVAILABLE_COUNTRIES=GH
# Afriex USD SWIFT payout coverage reference. Do not merge into active Bank Account
# pickers until recipient email, address, SWIFT/BIC, and invoice fields are wired.
AFRIEX_SWIFT_PAYOUT_COUNTRIES=DZ,BJ,BW,BF,CM,CF,CG,CI,CD,EG,ET,GA,GM,GH,GN,GW,KE,MG,MW,ML,MA,MZ,NA,NE,NG,RW,SN,SL,ZA,SS,TZ,TG,TN,UG,ZM,ZW,AR,BR,CA,CL,CO,HT,MX,PE,US,UY,AT,BE,BG,HR,CY,CZ,DK,EE,FI,FR,DE,GI,GR,HU,IE,IT,LV,LI,LT,LU,MT,NL,NO,PL,PT,RO,RU,SK,SI,ES,SE,CH,UA,GB,AU,BD,CN,HK,ID,IN,JP,KR,KW,MY,NZ,PH,PK,QA,SA,SG,TH,TR,AE,VN
# Optional temporary corridor pause list for provider routes that are exposed
# in institutions but not actually payout-capable in the current environment.
AFRIEX_PAYOUT_PAUSED_COUNTRIES=BF,CF,CD,ML,MA,SS,TG
# Optional UAT override: countries listed here still stay in the raw pause list,
# but they reappear in the picker and bypass the temporary pause gate so you can
# test them one by one and capture the exact provider failure.
AFRIEX_PAYOUT_UAT_COUNTRIES=
AFRIEX_MOBILE_MONEY_DEPOSIT_COUNTRIES=BJ,CM,CI,ET,KE,TZ,UG
AFRIEX_MOBILE_MONEY_DEPOSIT_PAUSED_COUNTRIES=BF,CG,GA,GH,MW,MZ,RW,SL,ZM
AFRIEX_MOBILE_MONEY_DEPOSIT_UAT_COUNTRIES=
# Stripe card collection is a source/funding policy, not an Afriex payout list.
# `STRIPE` means the backend does not impose an issuer-country allowlist; Stripe
# still makes the final card, country, currency, fraud, and authorization decision.
STRIPE_CARD_COLLECTION_COUNTRIES=STRIPE
STRIPE_REMITTANCE_COLLECTION_APPROVED=true
# Default only; app_config/fee_settings is authoritative after the owner saves Fee Settings.
CONFIG_STRIPE_TRANSACTION_OWNER_FEE_RATE=0.006

# Hosted wallet provisioning and provider-backed wallet flows use the same
# Afriex/mobile-money config that cash-in/cash-out already depends on.
MOBILE_MONEY_PROVIDER_MODE=HTTP_API
MOBILE_MONEY_PROVIDER_NAME=AFRIEX
MOBILE_MONEY_PROVIDER_API_BASE_URL=https://sandbox.api.afriex.com/api/v1
MOBILE_MONEY_PROVIDER_URL=https://sandbox.api.afriex.com/api/v1/transaction
MOBILE_MONEY_COLLECTION_URL=https://sandbox.api.afriex.com/api/v1/transaction
MOBILE_MONEY_PROVIDER_API_KEY=
MOBILE_MONEY_PROVIDER_AUTH_HEADER=x-api-key
MOBILE_MONEY_PROVIDER_API_KEY_PREFIX=
MOBILE_MONEY_PROVIDER_TIMEOUT_MS=30000
MOBILE_MONEY_PROVIDER_ACTIVE_CONF_URL=
MOBILE_MONEY_PROVIDER_ACTIVE_CONF_CACHE_TTL_MS=300000
MOBILE_MONEY_PROVIDER_WEBHOOK_PUBLIC_KEY=
MOBILE_MONEY_PROVIDER_WEBHOOK_SECRET=
MOBILE_MONEY_PROVIDER_WEBHOOK_HEADER=x-mobile-money-webhook-secret
MOBILE_MONEY_AFRIEX_ACCESS_PROBE_COUNTRY=UG
MOBILE_MONEY_AFRIEX_SKIP_ACCESS_PROBE=true

# -----------------------------------------------------------------------------
# Mobile money / account phone OTP (Twilio Verify)
# Required for: Add Mobile Money (Payment Methods), account phone verification,
# and agent customer wallet OTP flows. Without this, Send OTP returns
# "Phone verification is not available right now."
# Value must be exactly: twilio_verify  (not TWILIO_VERIFY or TWILLO_VERIFY)
# Create a Verify Service in Twilio Console → Verify → Services.
# -----------------------------------------------------------------------------
MOBILE_MONEY_PHONE_OTP_PROVIDER=twilio_verify
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_FROM_NUMBER=
# Optional HMAC fallback for legacy/local OTP hashing (Twilio Verify path ignores this).
MOBILE_MONEY_PHONE_OTP_SECRET=

# Afriex environments are intentionally split. Production requires the live API
# key and signed-webhook public key below; switch to sandbox only for UAT.
AFRIEX_ENV=live
AFRIEX_SANDBOX_API_BASE_URL=https://sandbox.api.afriex.com
AFRIEX_SANDBOX_API_KEY=
AFRIEX_SANDBOX_WEBHOOK_PUBLIC_KEY=
AFRIEX_SANDBOX_WEBHOOK_SECRET=
AFRIEX_SANDBOX_WEBHOOK_HEADER=x-afriex-webhook-secret

# Production values: never reuse sandbox credentials here.
AFRIEX_LIVE_API_BASE_URL=https://api.afriex.com
AFRIEX_LIVE_API_KEY=
AFRIEX_LIVE_AUTH_HEADER=x-api-key
AFRIEX_LIVE_API_KEY_PREFIX=
AFRIEX_LIVE_WEBHOOK_PUBLIC_KEY=
AFRIEX_LIVE_WEBHOOK_SECRET=
AFRIEX_LIVE_WEBHOOK_HEADER=x-afriex-webhook-secret
AFRIEX_LIVE_REQUEST_SIGNING_SECRET=
# Afriex production cap supplied during onboarding. The provider remains the
# final authority for its business-wide daily limit and non-USD equivalents.
AFRIEX_LIVE_MAX_PAYOUT_USD=2000

# Legacy sandbox aliases retained for existing local UAT setups.
AFRIEX_API_BASE_URL=https://sandbox.api.afriex.com
AFRIEX_PROVIDER_URL=https://sandbox.api.afriex.com/api/v1
AFRIEX_API_KEY=
# Optional: pin this only when Afriex asks you to use a specific API version.
AFRIEX_API_VERSION=
AFRIEX_AUTH_HEADER=x-api-key
AFRIEX_API_KEY_PREFIX=
AFRIEX_TIMEOUT_MS=30000
# Prefer RSA/EC public key verification (x-webhook-signature). Shared secret is fallback only.
AFRIEX_WEBHOOK_PUBLIC_KEY=
AFRIEX_WEBHOOK_SECRET=
AFRIEX_WEBHOOK_HEADER=x-afriex-webhook-secret
# Soft webhook verify is SANDBOX ONLY (ignored when Afriex runtime is live).
# true/1: accept unsigned sandbox/test deliveries when RSA verify fails.
# false/0: always require signature (or shared-secret fallback).
# Production/live never soft-accepts — set false before go-live.
AFRIEX_WEBHOOK_SOFT_VERIFY=true

# -----------------------------------------------------------------------------
# Stripe (Connect + saved-card checkout)
# -----------------------------------------------------------------------------
# IMPORTANT:
# - Production card processing requires matching live client and server keys.
# - For sandbox testing, comment the production values and activate both test values.
# - Do NOT use deprecated `firebase functions:config:set` (removed March 2027).
#   Keep values in this `.env` file and run `firebase deploy --only functions`.
#   Optional one-time migration from old runtime config:
#     firebase experiments:enable legacyRuntimeConfigCommands
#     firebase functions:config:export
STRIPE_ENV=live
STRIPE_SECRET_KEY=
# Required by `stripeWebhook`; use the live endpoint signing secret from Stripe.
STRIPE_WEBHOOK_SECRET=
# Optional: signing secret for the separate Stripe Connected accounts destination.
# Keep this distinct from STRIPE_WEBHOOK_SECRET, which is for Your account events.
STRIPE_WEBHOOK_SECRET_CONNECTED_ACCOUNTS=
# Optional temporary overlap during an endpoint-secret rotation. Remove it after
# Stripe retries for the old destination are complete.
STRIPE_WEBHOOK_SECRET_PREVIOUS=

# Sandbox fallback (activate both lines together for test deployments):
# STRIPE_ENV=test
# STRIPE_SECRET_KEY_TEST=

# Stripe Connect onboarding for Stripe-managed-risk direct charges. Seller
# accounts use the full Stripe Dashboard; payout details are managed there.
# RETURN + REFRESH are required by `createConnectOnboardingLink`.
STRIPE_CONNECT_RETURN_URL=https://volunteersapp-968b2.web.app/stripe/connect/return
STRIPE_CONNECT_REFRESH_URL=https://volunteersapp-968b2.web.app/stripe/connect/refresh
STRIPE_CONNECT_FAILURE_URL=https://volunteersapp-968b2.web.app/stripe/connect/failurez
STRIPE_CONNECT_SUCCESS_URL=https://volunteersapp-968b2.web.app/stripe/connect/success
STRIPE_CONNECT_ACCOUNT_TYPE=standard
STRIPE_CONNECT_COUNTRY=US

# -----------------------------------------------------------------------------
# Agora Cloud Recording (live replay archive)
# -----------------------------------------------------------------------------
# Enable automatic live replay archive start/stop when live_sessions are created
# and ended. If disabled or incomplete, live sessions still work but replay status
# will show as not configured.
AGORA_RECORDING_ENABLED=false

# Agora REST credentials for Cloud Recording.
# In the Agora Console, open:
# Account / RESTful API -> Customer ID and Customer Secret
AGORA_RECORDING_CUSTOMER_ID=
AGORA_RECORDING_CUSTOMER_SECRET=

# How long the recorder waits for a publisher before timing out.
AGORA_RECORDING_MAX_IDLE_TIME_SECONDS=600

# How long the acquired recording resource stays valid.
AGORA_RECORDING_RESOURCE_EXPIRED_HOURS=24

# Third-party storage target used by Agora Cloud Recording.
# Vendor / region codes depend on your chosen provider in Agora Cloud Recording docs.
# Fill these from the same storage provider you configure inside Agora Cloud Recording.
# Common pattern:
# - vendor: numeric code for your Agora-supported storage target
# - region: numeric region code required by Agora for that bucket
AGORA_RECORDING_STORAGE_VENDOR=
AGORA_RECORDING_STORAGE_REGION=
AGORA_RECORDING_STORAGE_BUCKET=
AGORA_RECORDING_STORAGE_ACCESS_KEY=
AGORA_RECORDING_STORAGE_SECRET_KEY=

# Optional path prefix inside the storage bucket. Session id is appended automatically.
# Example: live_archives
AGORA_RECORDING_STORAGE_FILE_NAME_PREFIX=live_archives

# Optional public base URL for replay playback. When set, iOS can open archived
# HLS/MP4 recordings directly from the app after processing completes.
# Example: https://cdn.example.com/live_archives
# For a plain bucket origin, use the public or CDN base URL that points to the
# same bucket/prefix used above.
AGORA_RECORDING_PLAYBACK_BASE_URL=

# -----------------------------------------------------------------------------
# Live replay access links
# -----------------------------------------------------------------------------
# Optional dedicated secret for signing short-lived replay access links. If blank,
# the server falls back to recording / Agora secrets so replay access still works
# once recording is configured. Setting an explicit secret is recommended.
LIVE_REPLAY_ACCESS_SECRET=

# Optional callable/redirect base URL override if you front replay access through
# another origin. Leave blank to use the default Cloud Functions URL.
LIVE_REPLAY_ACCESS_BASE_URL=

# Signed replay playback links are short-lived by default.
LIVE_REPLAY_ACCESS_TTL_SECONDS=900

# Host-created replay share links can live longer.
LIVE_REPLAY_SHARE_TTL_SECONDS=86400

# -----------------------------------------------------------------------------
# Hosted live share links
# -----------------------------------------------------------------------------
# Optional dedicated secret for signing browser-ready live share links. If blank,
# the server falls back to the replay access secret.
LIVE_SHARE_ACCESS_SECRET=

# Optional custom-domain live page. Leave blank to default to
# https://softsolutionstech.com/live.
LIVE_SHARE_BASE_URL=

# Active live share links are medium-lived because they embed browser watch
# access for view-only streaming.
LIVE_SHARE_ACCESS_TTL_SECONDS=21600

# Replay shares routed through the hosted /live page can live longer.
LIVE_SHARE_REPLAY_TTL_SECONDS=86400

# -----------------------------------------------------------------------------
# Transactional email (verification + password reset via Resend)
# -----------------------------------------------------------------------------
# Shared sender configuration.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# Optional explicit providers. If omitted, password reset falls back to Resend
# automatically when the two values above are present.
EMAIL_VERIFICATION_PROVIDER=resend
PASSWORD_RESET_EMAIL_PROVIDER=resend
PASSWORD_RESET_APP_NAME=VolunteersApp
# Optional comma-separated allowlist of expected password reset hosts for safe diagnostics.
# Example: volunteersapp-968b2.firebaseapp.com,volunteersapp-968b2.web.app
PASSWORD_RESET_EXPECTED_HOSTS=

# -----------------------------------------------------------------------------
# Sponsored ad wallet listing fee (USD) used ONLY when Firestore
# `app_config/fee_settings` is missing. Live apps should set `adPostFeeUsd`
# (and optional legacy `sponsoredAdFeeUsd`) via Owner → Fee Settings.
# -----------------------------------------------------------------------------
SPONSORED_AD_LISTING_FEE_USD=0
# Alias supported in code:
CONFIG_AD_POST_FEE_USD=0
