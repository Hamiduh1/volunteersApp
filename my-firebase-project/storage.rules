rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Requires Blaze: Storage rules calling firestore.* (see Firebase docs).
    function isChatAttachmentParticipant(chatId) {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/chats/$(chatId)) &&
        firestore.get(/databases/(default)/documents/chats/$(chatId)).data.get('participants', []) is list &&
        request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.get('participants', []);
    }

    // Deny all by default
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // --- EVENT IMAGES ---
    // Path: event_images/{userId}/{eventId}/{fileName}
    // Organizers can upload images for events they create
    match /event_images/{userId}/{eventId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId && 
                      request.resource.size < 10 * 1024 * 1024 && // Max 10MB
                      request.resource.contentType.matches('image/.*');
      allow delete: if request.auth.uid == userId;
    }

    // --- PROFILE IMAGES ---
    // Path: profile_images/{userId}/{fileName}
    match /profile_images/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId && 
                      request.resource.size < 5 * 1024 * 1024;  // Max 5MB
      allow delete: if request.auth.uid == userId;
    }

    // --- BLIND DATE MEDIA ---
    // Path: blind_date_media/{userId}/{fileName}
    match /blind_date_media/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                      request.auth.uid == userId &&
                      request.resource.size < 10 * 1024 * 1024 &&
                      request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // --- LEGACY DATING PROFILE IMAGES ---
    // Path: dating_images/{userId}/{fileName}
    match /dating_images/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                      request.auth.uid == userId &&
                      request.resource.size < 10 * 1024 * 1024 &&
                      request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // --- MINDLOOM MEDIA ---
    // Paths:
    // joke_images/{userId}/{fileName}
    // joke_videos/{userId}/{fileName}
    // joke_docs/{userId}/{fileName}
    // joke_misc/{userId}/{fileName}

    match /joke_images/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                      request.auth.uid == userId &&
                      request.resource.size < 15 * 1024 * 1024 &&
                      request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /joke_videos/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                      request.auth.uid == userId &&
                      request.resource.size < 200 * 1024 * 1024 &&
                      request.resource.contentType.matches('video/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /joke_docs/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                      request.auth.uid == userId &&
                      request.resource.size < 25 * 1024 * 1024 &&
                      request.resource.contentType == 'application/pdf';
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /joke_misc/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // --- ADVERTISEMENT MEDIA ---
    // Path: ads/{userId}/{fileName}
    match /ads/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                      request.auth.uid == userId &&
                      request.resource.size < 200 * 1024 * 1024 &&
                      (
                        request.resource.contentType.matches('image/.*') ||
                        request.resource.contentType.matches('video/.*') ||
                        request.resource.contentType.matches('application/.*')
                      );
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // --- GARAGE SALE MEDIA ---
    // Path: garage_sales/{userId}/{fileName}
    match /garage_sales/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                      request.auth.uid == userId &&
                      request.resource.size < 200 * 1024 * 1024 &&
                      (
                        request.resource.contentType.matches('image/.*') ||
                        request.resource.contentType.matches('video/.*') ||
                        request.resource.contentType.matches('application/.*')
                      );
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // --- MARKETPLACE MEDIA ---
    // Path: marketplace_images/{userId}/{fileName}
    match /marketplace_images/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                      request.auth.uid == userId &&
                      request.resource.size < 25 * 1024 * 1024 &&
                      request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // --- CHAT MEDIA ---
    // Path: chat_media/{userId}/{fileName}
    match /chat_media/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                      request.auth.uid == userId &&
                      (
                        (
                          request.resource.contentType == 'image/jpeg' &&
                          request.resource.size < 8 * 1024 * 1024
                        ) ||
                        (
                          request.resource.contentType.matches('video/.*') &&
                          request.resource.size < 20 * 1024 * 1024
                        )
                      );
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // --- CHAT ATTACHMENTS (PARITY PATH) ---
    // Path: chat_attachments/{chatId}/{messageId}.{ext}
    // Android/iOS parity upload path for conversation attachments.
    match /chat_attachments/{chatId}/{fileName} {
      allow read: if isChatAttachmentParticipant(chatId);
      allow write: if isChatAttachmentParticipant(chatId) &&
                      (
                        (
                          request.resource.contentType == 'image/jpeg' &&
                          request.resource.size < 8 * 1024 * 1024
                        ) ||
                        (
                          request.resource.contentType.matches('video/.*') &&
                          request.resource.size < 20 * 1024 * 1024
                        )
                      );
      allow delete: if isChatAttachmentParticipant(chatId);
    }

    // --- GALLERY UPLOADS ---
    // Path: gallery_uploads/{userId}/{fileName}
    match /gallery_uploads/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                      request.auth.uid == userId &&
                      request.resource.size < 25 * 1024 * 1024 &&
                      request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
